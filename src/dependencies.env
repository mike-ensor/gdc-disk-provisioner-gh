# ==============================================================================
# GDC ISO Offline Binary and Core Package Dependencies Manifest
# ==============================================================================
# Declares standard download endpoints, precise cryptographic signatures, 
# and target destination paths on the remastered ISO for all Service Hub assets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITEA BOUNDARY HUB (Go Binary)
# ------------------------------------------------------------------------------
# Desired Location inside ISO: /custom-data/gitea/gitea
GITEA_BINARY_URL=https://github.com/go-gitea/gitea/releases/download/v1.22.1/gitea-1.22.1-linux-amd64
GITEA_BINARY_FILENAME=gitea-1.22.1-linux-amd64
GITEA_BINARY_SHA256=b8043324545eec269fc8f18c22b49fc365ed367e0dd41e081b79832de2570f9c
GITEA_ISO_DEST_DIR=/custom-data/gitea

# ------------------------------------------------------------------------------
# 2. ECLIPSE TEMURIN OPENJDK JRE 17 (adoptium JRE for Sonatype Nexus)
# ------------------------------------------------------------------------------
# Desired Location inside ISO: /custom-data/nexus/jre
JRE_PACKAGE_URL=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.11%2B9/OpenJDK17U-jre_x64_linux_hotspot_17.0.11_9.tar.gz
JRE_PACKAGE_FILENAME=OpenJDK17U-jre_x64_linux_hotspot_17.0.11_9.tar.gz
JRE_PACKAGE_SHA256=bcb1b7b8ad68c93093f09b591b7cb17161d39891f7d29d33a586f5a328603707
JRE_ISO_DEST_DIR=/custom-data/nexus/jre

# ------------------------------------------------------------------------------
# 3. SONATYPE NEXUS REPOSITORY MANAGER (v3.69.0-02 Unix Distribution)
# ------------------------------------------------------------------------------
# Desired Location inside ISO: /custom-data/nexus/nexus-bin and /custom-data/nexus/sonatype-work
NEXUS_PACKAGE_URL=https://download.sonatype.com/nexus/3/nexus-3.69.0-02-unix.tar.gz
NEXUS_PACKAGE_FILENAME=nexus-3.69.0-02-unix.tar.gz
NEXUS_PACKAGE_SHA256=eec80b3ee33dde61443e54dddea258f851951c4aef81c4c6256c1205ca818162
NEXUS_ISO_DEST_DIR=/custom-data/nexus

# ------------------------------------------------------------------------------
# 4. CUSTOM/ADDITIONAL DEPENDENCY TARBALL PACKAGES (FUTURE EXTENSION)
# ------------------------------------------------------------------------------
# To bake optional packages or custom script archives (e.g. customized deb suites,
# firmware drivers, or third-party playbooks) in addition to the core dependencies.
# Desired Location inside ISO: /custom-data/extra-packages
CUSTOM_DEPS_TARBALL_URL=
CUSTOM_DEPS_TARBALL_FILENAME=
CUSTOM_DEPS_TARBALL_SHA256=
CUSTOM_DEPS_ISO_DEST_DIR=/custom-data/extra-packages
