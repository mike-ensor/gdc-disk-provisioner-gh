# Generated by GDC Post-Install Ansible-Pull Provisioner
# Persistent Chrony configuration for GDC offline nodes

# NTP Server Sources (Google Pools)
{% for server in ntp_upstream_servers %}
server {{ server }} iburst
{% endfor %}

# Allow stepping the clock if offset exceeds threshold
makestep {{ chrony_makestep_threshold }} {{ chrony_makestep_limit }}

# Record drift
driftfile /var/lib/chrony/chrony.drift

# Logging configuration
logdir /var/log/chrony
log tracking measurements statistics

# Stop acting as a server, keep client mode only
port 0

# Enforce synchronization bounds
rtcsync
