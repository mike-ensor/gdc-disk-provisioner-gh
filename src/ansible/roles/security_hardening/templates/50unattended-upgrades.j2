// Generated by GDC Post-Install Ansible-Pull Provisioner
// Persistent Unattended-Upgrades Configuration for reboot-free operation

Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
};

// Package Blacklist to prevent automatic reboots
Unattended-Upgrade::Package-Blacklist {
{% for package in gdc_unattended_blacklist %}
    "{{ package }}";
{% endfor %}
};

// Performance and reliability options
Unattended-Upgrade::Deviating-Confirm-Reboot "false";
Unattended-Upgrade::Automatic-Reboot "false";
