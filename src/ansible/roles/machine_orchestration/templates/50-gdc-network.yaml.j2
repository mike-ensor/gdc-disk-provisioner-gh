network:
  version: 2
  renderer: networkd
  ethernets:
    # We dynamically select the default management interface
    {{ gdc_primary_interface }}:
{% if machine_config.network is not defined or machine_config.network.management_network is not defined or machine_config.network.management_network.dhcp_v4 | default(false) %}
      dhcp4: true
{% else %}
      dhcp4: false
      addresses:
        - {{ machine_config.network.management_network.ip_cidr }}
      routes:
        - to: default
          via: {{ machine_config.network.management_network.gateway }}
      nameservers:
        addresses:
{% for dns in machine_config.network.management_network.dns_servers %}
          - {{ dns }}
{% endfor %}
{% endif %}

{% if machine_config.network is defined and machine_config.network.cluster_network is defined and machine_config.network.cluster_network.vlan_id | default(109) | int > 0 %}
  vlans:
    vlan{{ machine_config.network.cluster_network.vlan_id | default(109) }}:
      id: {{ machine_config.network.cluster_network.vlan_id | default(109) }}
      link: {{ gdc_primary_interface }}
{% if machine_config.network.cluster_network.dhcp_v4 | default(false) %}
      dhcp4: true
{% else %}
      dhcp4: false
      addresses:
        - {{ machine_config.network.cluster_network.ip_cidr }}
{% if machine_config.network.cluster_network.gateway is defined %}
      routes:
        - to: default
          via: {{ machine_config.network.cluster_network.gateway }}
          metric: 200
{% endif %}
{% endif %}
{% endif %}
