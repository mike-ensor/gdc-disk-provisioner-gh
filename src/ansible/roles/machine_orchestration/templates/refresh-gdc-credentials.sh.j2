set -euo pipefail

# ==============================================================================
# TEMPORARY WORKAROUND: ADC EXECUTABLE WRAPPER
# ==============================================================================
# This script wraps the OAuth 2.0 access token into an ADC-compatible format.
# Future state: Migrate to native OIDC Identity Tokens and Workload Identity Federation
# once the GDC Companion API is updated. See FUTURE SECURITY TASK in PROGRESS.md.
# ==============================================================================

echo "[-] Refreshing GDC credentials and access token..."

# Ensure the auth RAM disk directory exists
mkdir -p /run/gdc-auth 2>/dev/null || true
chmod 755 /run/gdc-auth 2>/dev/null || true

# RENEW STEP-CA MTLS CERTIFICATE
# step ca renew will only actually renew if the certificate has passed ~2/3rds of its lifetime,
# but passing --force bypasses prompt/tty requirements.
if command -v step >/dev/null 2>&1 && [[ -f "/var/gdc-install/keys/client.crt" ]] && [[ -f "/var/gdc-install/keys/client.key" ]]; then
    # We need STEPPATH explicitly set to ensure the CA config (defaults.json) is found if run by different users
    export STEPPATH="/root/.step"
    
    EXTRA_ARGS=()
    if [[ -f "/var/gdc-install/keys/root_ca.crt" ]]; then
        # If we downloaded the root CA directly during TOFU (bypassing step ca bootstrap),
        # we must explicitly pass the CA URL and root certificate path to renew.
        EXTRA_ARGS=(--ca-url="{{ gdc_step_ca_url }}" --root="/var/gdc-install/keys/root_ca.crt")
    fi
    
    echo "[-] Checking mTLS client certificate renewal via Step CA..."
    if RENEW_OUT=$(step ca renew /var/gdc-install/keys/client.crt /var/gdc-install/keys/client.key --force "${EXTRA_ARGS[@]}" 2>&1); then
        echo "[+] mTLS certificate status: ${RENEW_OUT}"
    else
        echo "WARN: Failed to renew mTLS certificate: ${RENEW_OUT}" >&2
    fi
elif ! command -v step >/dev/null 2>&1; then
    echo "[-] 'step' CLI not found, skipping mTLS certificate renewal."
else
    echo "[-] Client certificates not found at /var/gdc-install/keys/, skipping renewal."
fi

# RENEW GCLOUD OAUTH TOKEN VIA GDC COMPANION
# Discover MAC address of the active primary interface
PHYS_IFACE=$(ip link show | awk -F': ' '/state UP/ {getline; print $0}' | awk -F': ' '/^ / {next} {print $2}' | grep -E '^e' | head -n 1 || ip link show | awk -F': ' '/state UP/ && $2 ~ /^e/ {print $2}' | head -n 1 || true)
if [ -z "$PHYS_IFACE" ]; then PHYS_IFACE=$(ls /sys/class/net | grep -E '^e' | head -n 1 || echo "eth0"); fi
NODE_MAC=$(cat "/sys/class/net/${PHYS_IFACE}/address" 2>/dev/null | tr '[:upper:]' '[:lower:]' || echo "unknown")

COMPANION_URL="{{ gdc_companion_base_url }}v1/machine-credentials/gcp-token/${NODE_MAC}"

echo "[-] Node identity:"
echo "    Interface:     ${PHYS_IFACE}"
echo "    MAC Address:   ${NODE_MAC}"
echo "[-] Requesting token from Companion endpoint:"
echo "    URL:           ${COMPANION_URL}"

# Fetch the token from Companion using the mTLS certificate
CURL_ERR_FILE=$(mktemp)
HTTP_RESPONSE=$(curl -s -S -w "\n%{http_code}" -X GET "${COMPANION_URL}" \
    --cert /var/gdc-install/keys/client.crt \
    --key /var/gdc-install/keys/client.key 2>"${CURL_ERR_FILE}" || true)
CURL_STDERR=$(cat "${CURL_ERR_FILE}" 2>/dev/null || true)
rm -f "${CURL_ERR_FILE}"

LAST_LINE=$(echo "${HTTP_RESPONSE}" | tail -n 1)
if [[ "${LAST_LINE}" =~ ^[0-9]{3}$ ]]; then
    HTTP_STATUS="${LAST_LINE}"
    TOKEN_JSON=$(echo "${HTTP_RESPONSE}" | head -n -1)
else
    if echo "${HTTP_RESPONSE}" | grep -q "access_token"; then
        HTTP_STATUS="200"
    else
        HTTP_STATUS="Failed"
    fi
    TOKEN_JSON="${HTTP_RESPONSE}"
fi

echo "[-] Companion response status: HTTP ${HTTP_STATUS}"
if [[ -n "${CURL_STDERR}" ]]; then
    echo "[-] Curl output: ${CURL_STDERR}"
fi

# Parse the JSON and write purely the token to the tmpfs file
if [[ "${HTTP_STATUS}" =~ ^2[0-9]{2}$ ]] && echo "${TOKEN_JSON}" | grep -q "access_token"; then
    if command -v jq >/dev/null 2>&1; then
        RAW_TOKEN=$(echo "${TOKEN_JSON}" | jq -r '.access_token // empty')
        EXPIRES_IN=$(echo "${TOKEN_JSON}" | jq -r '.expires_in // 3600')
        TOKEN_TYPE=$(echo "${TOKEN_JSON}" | jq -r '.token_type // "Bearer"')
    else
        RAW_TOKEN=$(echo "${TOKEN_JSON}" | grep -o '"access_token":"[^"]*"' | cut -d'"' -f4)
        EXPIRES_IN=$(echo "${TOKEN_JSON}" | grep -o '"expires_in":[0-9]*' | cut -d':' -f2 || true)
        if [ -z "${EXPIRES_IN}" ]; then EXPIRES_IN="3600"; fi
        TOKEN_TYPE=$(echo "${TOKEN_JSON}" | grep -o '"token_type":"[^"]*"' | cut -d'"' -f4 || true)
        if [ -z "${TOKEN_TYPE}" ]; then TOKEN_TYPE="Bearer"; fi
    fi

    echo "${RAW_TOKEN}" > /run/gdc-auth/access_token
    # Set permissive ACLs so both root and gdc-admin can read it
    chmod 644 /run/gdc-auth/access_token
    
    EXP_TIMESTAMP=$(date -d '+55 minutes' +%s)
    # Write the ADC-compatible output
    cat <<ADC_EOF > /run/gdc-auth/adc_token.json
{
  "version": 1,
  "success": true,
  "token_type": "Bearer",
  "access_token": "${RAW_TOKEN}",
  "expiration_time": ${EXP_TIMESTAMP}
}
ADC_EOF
    chmod 644 /run/gdc-auth/adc_token.json

    TOKEN_LEN=${#RAW_TOKEN}
    if [[ ${TOKEN_LEN} -gt 16 ]]; then
        MASKED_TOKEN="${RAW_TOKEN:0:10}...${RAW_TOKEN: -6}"
    else
        MASKED_TOKEN="***"
    fi

    echo "[+] Successfully received GCP access token from Companion."
    echo "    Token:       ${MASKED_TOKEN} (${TOKEN_LEN} chars)"
    echo "    Type:        ${TOKEN_TYPE}"
    echo "    Expires In:  ${EXPIRES_IN}s"
    echo "    ADC Staged:  /run/gdc-auth/adc_token.json (valid until $(date -d "@${EXP_TIMESTAMP}" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || echo "+55m"))"
else
    echo "ERROR: Failed to fetch a valid access token from Companion (HTTP ${HTTP_STATUS})." >&2
    if [[ -n "${TOKEN_JSON}" ]]; then
        echo "[-] Companion response body: ${TOKEN_JSON}" >&2
    fi

    # Helper to ensure adc_token.json is present for downstream GCP SDKs
    sync_adc_token() {
        if [[ ! -s /run/gdc-auth/adc_token.json ]] && [[ -s /run/gdc-auth/access_token ]]; then
            local raw_tok
            raw_tok=$(cat /run/gdc-auth/access_token)
            local exp_ts
            exp_ts=$(date -d '+55 minutes' +%s)
            cat <<ADC_EOF > /run/gdc-auth/adc_token.json
{
  "version": 1,
  "success": true,
  "token_type": "Bearer",
  "access_token": "${raw_tok}",
  "expiration_time": ${exp_ts}
}
ADC_EOF
            chmod 644 /run/gdc-auth/adc_token.json
        fi
    }

    # FALLBACK: Did the curl fail, but we already have a fresh sideloaded token?
    # Check if the access_token file exists, is non-empty, and was modified less than 50 minutes ago
    if [[ -s "/run/gdc-auth/access_token" ]] && [[ -n "$(find /run/gdc-auth/access_token -mmin -50 2>/dev/null)" ]]; then
        TOKEN_AGE=$(stat -c %Y /run/gdc-auth/access_token 2>/dev/null || echo "0")
        CURRENT_TIME=$(date +%s)
        AGE_MIN=$(( (CURRENT_TIME - TOKEN_AGE) / 60 ))
        echo "WARN: Failed to fetch token from Companion, but local token is < 50 mins old (${AGE_MIN}m). Using existing."
        sync_adc_token
        exit 0
    elif [[ -f "/var/gdc-install/state/gdc-fact-manual.json" ]] && [[ -s "/run/gdc-auth/access_token" ]]; then
        echo "WARN: Companion API unreachable, but operating in manual mode with a sideloaded token. Proceeding."
        sync_adc_token
        exit 0
    else
        echo "ERROR: Failed to fetch a valid access token from Companion and no valid local token found." >&2
        exit 1
    fi
fi

