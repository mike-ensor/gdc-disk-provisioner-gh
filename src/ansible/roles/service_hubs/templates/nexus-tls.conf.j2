# /etc/nginx/sites-available/nexus-tls.conf
# Managed by GDC Ansible. Do not edit manually.

server {
    listen {{ gdc_nexus_https_port | default(443) }} ssl default_server;
    server_name {{ gdc_nexus_domain }}{% if gdc_nexus_alias is defined and gdc_nexus_alias %} {{ gdc_nexus_alias }}{% endif %};

    # Certificate & Key
    ssl_certificate     {{ gdc_nexus_cert_path }};
    ssl_certificate_key {{ gdc_nexus_key_path }};

    # TLS Protocols & Ciphers
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security Headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Default body limit for Web UI & REST APIs
    client_max_body_size 10M;

    # Route 1: Docker / OCI Registry v2 API
    location /v2/ {
        client_max_body_size 50G;
        client_body_buffer_size 512k;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        send_timeout 3600s;

        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # Route 2: APT repositories, Raw GGUF models, PyPI packages
    location /repository/ {
        client_max_body_size 50G;
        client_body_buffer_size 512k;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        send_timeout 3600s;

        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # Route 3: Web UI and REST API
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header X-Forwarded-Port $server_port;
    }
}
