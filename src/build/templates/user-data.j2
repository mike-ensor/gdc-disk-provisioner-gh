## template: jinja
#cloud-config

{% set boot_session_id = range(10000000, 99999999) | random %}

bootcmd:
  - echo "{{ companion_ip }} {{ companion_host }}" >> /etc/hosts
  - echo "127.0.0.1 security.ubuntu.com" >> /etc/hosts
  - echo "127.0.0.1 geoip.ubuntu.com" >> /etc/hosts
  - echo "127.0.0.1 geoip.canonical.com" >> /etc/hosts
{% if enable_phone_home %}
phone_home:
  url: "{{ companion_url }}/public?version={{ ISO_VERSION }}&session={{ boot_session_id }}&logname=phone-home"
  tries: 2
  post:
    - instance_id
    - hostname
    - fqdn
{% endif %}
autoinstall:
  version: 1
{% if enable_webhook %}
  reporting:
    webhook:
      type: webhook
      endpoint: "{{ companion_url }}/secure?version={{ ISO_VERSION }}&session={{ boot_session_id }}&logname=webhook"
      level: INFO
{% endif %}
  shutdown: reboot
  apt:
    fallback: offline-install
    unattended-upgrades:
      enabled: false
    preserve_sources_list: false
    primary:
      - arches: [default]
        uri: "file:///cdrom/"
        suites: [noble]
    security:
      - arches: [default]
        uri: "file:///cdrom/"
        suites: [noble]
  storage:
    swap:
      size: 0
{{ storage_config }}
  identity:
    hostname: gdc-standalone-node
    username: temporary-installer
    password: "{{ password_hash }}"
  locale: en_US.UTF-8
  keyboard: {layout: us}
  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "e*"
        dhcp4: true
  ssh:
    install-server: true
    allow-pw: true
    {% if temp_installer_ssh_pub_keys %}
    authorized-keys:
      - "{{ temp_installer_ssh_pub_keys }}"
    {% endif %}
  early-commands:
    - |
      # [GDC-INSTALL-STEP] Injecting mock companion data if present
      if [ -x /cdrom/custom-data/gdc/inject-mock.sh ]; then
        echo "[-] Found mock API injection script, executing..."
        bash /cdrom/custom-data/gdc/inject-mock.sh
      fi
    - |
      # [GDC-INSTALL-STEP 1/12] Deactivating default public sources & preparing bootstrap keys...
      echo "[-] [DEBUG-ISO] Purging Live CD parent public Ubuntu sources..."
      rm -f /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources
      # Write a persistent GDC LUKS key file inside /var/log/installer (shared tmpfs visible to both snap and host)
      mkdir -p /var/log/installer
      echo -n "temporary_bootstrap_key_to_be_enrolled_to_tpm" > /var/log/installer/gdc-luks-key
      chmod 600 /var/log/installer/gdc-luks-key
      sync /var/log/installer/gdc-luks-key || sync
    - |
      # Live-stream Subiquity server logs to serial console for real-time diagnostics
      touch /var/log/installer/subiquity-server-debug.log
      tail -f /var/log/installer/subiquity-server-debug.log > /dev/ttyS0 2>/dev/null &
    - |
      # [GDC-INSTALL-STEP 1.5/12] Force unload AMD CCP/SFH to prevent cryptsetup panics on the Live ISO
      if grep -qi "AuthenticAMD" /proc/cpuinfo; then
        echo "[-] AMD Platform detected: Forcefully unloading ccp, amd_sfh, pcie_mp2_amd modules..."
        modprobe -r ccp 2>/dev/null || true
        rmmod ccp 2>/dev/null || true
        modprobe -r amd_sfh 2>/dev/null || true
        rmmod amd_sfh 2>/dev/null || true
        modprobe -r pcie_mp2_amd 2>/dev/null || true
        rmmod pcie_mp2_amd 2>/dev/null || true
      fi
    - |
      # [GDC-INSTALL-STEP 2/12] Configuring Live CD root password & registering diagnostics...
      {% if gdc_debug_mode %}
      echo "[-] [DEBUG-ISO] Configuring Live CD Root passworded SSH entry..."
      echo "root:gdc-password-123" | chpasswd
      echo "ubuntu:gdc-password-123" | chpasswd
      {% if debug_extra_user and debug_extra_password_hash %}
      echo "[-] [DEBUG-ISO] Configuring Live CD extra debug user '{{ debug_extra_user }}'..."
      useradd -m -s /bin/bash -p '{{ debug_extra_password_hash }}' {{ debug_extra_user }} || usermod -p '{{ debug_extra_password_hash }}' {{ debug_extra_user }} || true
      usermod -aG sudo {{ debug_extra_user }} || true
      mkdir -p /etc/sudoers.d
      echo "{{ debug_extra_user }} ALL=(ALL) ALL" > /etc/sudoers.d/{{ debug_extra_user }}
      chmod 0440 /etc/sudoers.d/{{ debug_extra_user }}
      {% endif %}
      sed -i 's/#\?PasswordAuthentication.*/PasswordAuthentication yes/g' /etc/ssh/sshd_config
      sed -i 's/#\?PermitRootLogin.*/PermitRootLogin yes/g' /etc/ssh/sshd_config
      systemctl restart ssh || systemctl restart sshd
      {% endif %}
      
      # Register the Diagnostics script as a globally executable utility on the Live CD
      if [ -f /cdrom/custom-data/gdc-collector ]; then
        cp /cdrom/custom-data/gdc-collector /usr/local/bin/gdc-collector
        chmod +x /usr/local/bin/gdc-collector
        echo "[-] Diagnostics tool registered as globally executable: 'gdc-collector'"
      fi
      
      # Register the Companion binary as a globally executable utility on the Live CD
      if [ -f /cdrom/custom-data/gdc-companion ]; then
        cp /cdrom/custom-data/gdc-companion /usr/local/bin/gdc-companion
        chmod +x /usr/local/bin/gdc-companion
        echo "[-] Companion tool registered as globally executable: 'gdc-companion'"
      fi
    - |
      # [GDC-INSTALL-STEP 3/12] Dynamically compiling local LVM layout...
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Dynamically configuring LVM storage layout"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Dynamically configuring LVM storage layout"
      if [ -f /cdrom/custom-data/generate_storage_config.sh ]; then
        cp /cdrom/custom-data/generate_storage_config.sh /tmp/generate_storage_config.sh
        chmod +x /tmp/generate_storage_config.sh
        if /tmp/generate_storage_config.sh; then
          echo "[-] Storage configuration generated successfully."
          if python3 -c "import os, yaml; bp = '/run/installer/autoinstall-user-data' if os.path.exists('/run/installer/autoinstall-user-data') else '/cdrom/nocloud/user-data'; c = yaml.safe_load(open(bp)); s = yaml.safe_load(open('/run/autoinstall-storage.yaml')); c['autoinstall']['storage'] = s['storage']; yaml.safe_dump({'autoinstall': c['autoinstall']}, open('/autoinstall.yaml', 'w')); os.makedirs('/run/installer', exist_ok=True); yaml.safe_dump(c, open('/run/installer/autoinstall-user-data', 'w'))"; then
            logger -t gdc-provisioner "[GOAL] LVM storage layout merged dynamically successfully."
          else
            echo "[GDC-INSTALL-FAIL] Critical Failure: Dynamic storage config merger failed!" >/dev/ttyS0
            exit 1
          fi
        else
          echo "[GDC-INSTALL-FAIL] Critical Failure: Dynamic storage config generator failed!" >/dev/ttyS0
          exit 1
        fi
      else
        echo "[!] Warning: Dynamic storage config generator not found on ISO! Falling back to static build config."
      fi
    - |
      # [GDC-INSTALL-STEP 4/12] Performing defensive disk sanitization and memory cache flushes...
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Performing defensive block device sanitization & cache flushes"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Performing defensive block device sanitization & cache flushes"

      # Discover installer live media disks to prevent self-erasure when booted from USB
      INSTALLER_DISKS=""
      for mnt in /cdrom /isodevice /run/live/medium; do
        if dev=$(findmnt -no SOURCE "${mnt}" 2>/dev/null) && [ -n "${dev}" ]; then
          real_dev=$(readlink -f "${dev}" 2>/dev/null || echo "${dev}")
          if [ -b "${real_dev}" ]; then
            case "${real_dev}" in
              *loop[0-9]*)
                back_file=$(losetup -O BACK-FILE -n "${real_dev}" 2>/dev/null || true)
                if [ -n "${back_file}" ]; then
                  loop_src=$(findmnt -no SOURCE -T "${back_file}" 2>/dev/null || true)
                  if [ -n "${loop_src}" ] && [ -b "${loop_src}" ]; then
                    loop_pk=$(lsblk -no PKNAME "${loop_src}" 2>/dev/null | head -n 1 | tr -d '[:space:]')
                    INSTALLER_DISKS="${INSTALLER_DISKS} ${loop_pk:-$(basename "${loop_src}")}"
                  fi
                fi
                ;;
              *)
                pkname=$(lsblk -no PKNAME "${real_dev}" 2>/dev/null | head -n 1 | tr -d '[:space:]')
                INSTALLER_DISKS="${INSTALLER_DISKS} ${pkname:-$(basename "${real_dev}")}"
                ;;
            esac
          fi
        fi
      done

      # Also detect any block devices hosting iso9660 filesystem
      for iso_dev in $(blkid -t TYPE=iso9660 -o device 2>/dev/null || true); do
        if [ -n "${iso_dev}" ] && [ -b "${iso_dev}" ]; then
          real_dev=$(readlink -f "${iso_dev}" 2>/dev/null || echo "${iso_dev}")
          pkname=$(lsblk -no PKNAME "${real_dev}" 2>/dev/null | head -n 1 | tr -d '[:space:]')
          INSTALLER_DISKS="${INSTALLER_DISKS} ${pkname:-$(basename "${real_dev}")}"
        fi
      done

      is_protected_dev() {
        target_dev="$1"
        [ -b "${target_dev}" ] || return 1
        bname=$(basename "${target_dev}")
        pkname=$(lsblk -no PKNAME "${target_dev}" 2>/dev/null | head -n 1 | tr -d '[:space:]')
        if [ -n "${pkname}" ]; then
          root_disk="${pkname}"
        elif [ -f "/sys/class/block/${bname}/partition" ]; then
          root_disk=$(basename "$(dirname "$(readlink -f "/sys/class/block/${bname}")")")
        else
          root_disk="${bname}"
        fi

        # Protect all known installer disks
        for inst_d in ${INSTALLER_DISKS}; do
          if [ "${root_disk}" = "${inst_d}" ] || [ "${bname}" = "${inst_d}" ]; then
            return 0
          fi
        done

        # Protect all USB block devices
        tran=$(lsblk -dno TRAN "/dev/${root_disk}" 2>/dev/null || true)
        if [ "${tran}" = "usb" ]; then
          return 0
        fi
        if [ -d "/sys/block/${root_disk}" ]; then
          syspath=$(readlink -f "/sys/block/${root_disk}" 2>/dev/null || true)
          case "${syspath}" in
            */usb*) return 0 ;;
          esac
        fi
        return 1
      }

      # A. Wipe all signatures on any existing partitions first before destroying partition table!
      for p in /dev/nvme*p* /dev/nvme* /dev/sd* /dev/mapper/*; do
        if [ -b "${p}" ]; then
          if is_protected_dev "${p}"; then
            echo "   -> [PROTECT] Skipping protected installer/USB device: ${p}"
            continue
          fi
          echo "   -> Wiping existing signatures on: ${p}"
          wipefs --all --force "${p}" 2>/dev/null || true
        fi
      done
      # B. Now safely deactivate Volume Groups and destroy partition tables on physical disks
      for d in $(lsblk -dno NAME | grep -vE 'loop|sr|ram'); do
        if is_protected_dev "/dev/${d}"; then
          echo "   -> [PROTECT] Preserving protected installer/USB storage disk: /dev/${d}"
          continue
        fi
        echo "   -> Cleaning device: /dev/${d}"
        # Deactivate any active Volume Groups on the device
        vgchange -an --force 2>/dev/null || true
        # Close any open dm mappings
        dmsetup remove_all --force || true
        # Attempt hardware-level blkdiscard to reset the SSD/NVMe drive
        echo "   -> Attempting hardware-level blkdiscard on: /dev/${d}"
        blkdiscard --force "/dev/${d}" 2>/dev/null || true
        
        # Unconditionally zero out the partition table and first 100MB of the disk to destroy all stale LUKS headers
        echo "   -> Zeroing out partition table and primary LUKS/GPT header region on: /dev/${d}"
        dd if=/dev/zero of="/dev/${d}" bs=1M count=100 oflag=direct status=none || true
        
        # Also zero out the last 16MB of the disk to destroy the backup GPT header!
        disk_size=$(blockdev --getsize64 "/dev/${d}" 2>/dev/null || echo "0")
        if [ "${disk_size}" -gt 16777216 ]; then
          seek_pos=$(( (disk_size - 16777216) / 1048576 ))
          dd if=/dev/zero of="/dev/${d}" bs=1M count=16 seek="${seek_pos}" oflag=direct status=none || true
        fi
        
        # --- SYNCHRONIZATION AND FLUSHING ---
        echo "   -> Synchronizing block device caches for /dev/${d}..."
        sync 2>/dev/null || true
        
        # 1. Flush dirty buffers with error-state check
        if ! err_out=$(blockdev --flushbufs "/dev/${d}" 2>&1); then
          echo "   -> [INFO] blockdev --flushbufs on /dev/${d} reported: ${err_out} (this is non-critical and normal when running under virtualized/emulated storage controller layers)."
        else
          echo "   -> [SUCCESS] blockdev --flushbufs completed successfully on /dev/${d}."
        fi
        
        # 2. Tell kernel to re-read partition tables with fallback routing on failure
        if ! err_out=$(blockdev --rereadpt "/dev/${d}" 2>&1); then
          echo "   -> [WARN] blockdev --rereadpt failed on /dev/${d}: ${err_out}. Attempting partprobe fallback..."
          if ! probe_err=$(partprobe "/dev/${d}" 2>&1); then
            echo "   -> [ERROR] Both blockdev rereadpt and partprobe failed on /dev/${d}: ${probe_err}! Stale partitions may continue to persist."
          else
            echo "   -> [SUCCESS] partprobe successfully refreshed the partition table map for /dev/${d}."
          fi
        else
          echo "   -> [SUCCESS] blockdev --rereadpt successfully refreshed the partition table map for /dev/${d}."
        fi

        # --- DETERMINISTIC POLLING VERIFICATION LOOP ---
        # Since we cleared the partition tables, all /dev/nvme0n1p* block devices should disappear from the kernel.
        # We poll the sysfs directory structure for nvme0n1 to verify they are gone.
        max_retries=30
        retry=0
        partitions_lingering=true
        
        echo "   -> Verifying partition block device removal for /dev/${d}..."
        while [ ${retry} -lt ${max_retries} ]; do
          # Check if any sub-partition directories exist in sysfs (e.g. nvme0n1p1 or sda1)
          if [ -d "/sys/class/block/${d}" ] && ! ls /sys/class/block/${d}/${d}* >/dev/null 2>&1; then
            echo "   -> [SUCCESS] Verified: All partition block devices for /dev/${d} have successfully disappeared from sysfs."
            partitions_lingering=false
            break
          fi
          retry=$((retry + 1))
          sleep 0.5
        done

        if [ "${partitions_lingering}" = "true" ]; then
          echo "   -> [ERROR] Partition block devices for /dev/${d} are STILL lingering in sysfs after 15 seconds! Forcing final udev settle."
          udevadm settle 2>/dev/null || true
        fi
      done
      
      # --- FINAL SYSTEM-WIDE SETTLEMENT ---
      echo "   -> Performing final system-wide sync and dropping page/inode caches..."
      sync && echo 3 > /proc/sys/vm/drop_caches
      udevadm settle 2>/dev/null || true
      echo "   -> Disk sanitization phase successfully finalized. Proceeding to partition."
    - |
      # Print GDC vintage parchment boot banner with version and build timestamp
      if [ -f /cdrom/custom-data/boot-banner.txt ]; then
        cat /cdrom/custom-data/boot-banner.txt > /dev/ttyS0 2>/dev/null || true
        cat /cdrom/custom-data/boot-banner.txt > /dev/console 2>/dev/null || true
        cat /cdrom/custom-data/boot-banner.txt
      fi
    - |
      # Stop and mask unattended-upgrades on the live installer to prevent installation delays
      systemctl stop unattended-upgrades || true
      systemctl mask unattended-upgrades || true
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Activating Live ISO network segment"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Activating Live ISO network segment"
      PHYS_IFACE=$(ls /sys/class/net | grep -E '^e' | head -n 1 || echo "eth0")
      
    - |
      # [GDC-INSTALL-STEP 4.5/12] Injecting cryptsetup wrapper to prevent argon2id OOM panics on HMB NVMe drives
      echo "[-] Deploying cryptsetup memory-limit wrapper..."
      cat << 'EOW' > /tmp/cryptsetup-wrapper
      #!/bin/bash
      if [[ "$*" == *"luksFormat"* ]]; then
        # Force pbkdf2 and low iteration count for fast, low-memory bootstrapping
        # This prevents 1GB argon2id allocations that crash DRAM-less NVMe HMB controllers
        exec /tmp/cryptsetup.orig --pbkdf pbkdf2 --pbkdf-force-iterations 1000 "$@"
      else
        exec /tmp/cryptsetup.orig "$@"
      fi
      EOW
      chmod +x /tmp/cryptsetup-wrapper
      
      # Backup the real binary
      cp $(which cryptsetup) /tmp/cryptsetup.orig
      
      # Bind mount the wrapper over all cryptsetup instances (including inside the read-only snap!)
      for cs in $(find /snap/subiquity -name cryptsetup -type f -executable 2>/dev/null); do
        mount --bind /tmp/cryptsetup-wrapper "$cs" || true
      done
      for cs in /sbin/cryptsetup /usr/sbin/cryptsetup /bin/cryptsetup /usr/bin/cryptsetup; do
        if [ -f "$cs" ]; then
          mount --bind /tmp/cryptsetup-wrapper "$cs" || true
        fi
      done
      # [GDC-INSTALL-STEP 5/12] Activating Live ISO network segment...
      VLAN_ID="{{ machine_vlan }}"
      if [ -z "${VLAN_ID}" ] || [ "${VLAN_ID}" = "0" ]; then
        # Untagged native configuration (directly on physical interface!)
        echo "[-] Running on untagged native network. Retaining existing DHCP configuration."
        ip link set dev "${PHYS_IFACE}" up || true
      else
        # Tagged VLAN configuration
        echo "[-] Running on tagged VLAN ${VLAN_ID}. Activating VLAN interface..."
        ip link add link "${PHYS_IFACE}" name "${PHYS_IFACE}.${VLAN_ID}" type vlan id "${VLAN_ID}" 2>/dev/null || true
        ip link set dev "${PHYS_IFACE}.${VLAN_ID}" up || true
        echo "[-] Requesting DHCP address on VLAN interface..."
        dhclient "${PHYS_IFACE}.${VLAN_ID}" 2>/dev/null || systemctl restart systemd-networkd || true
      fi
      
      # [GDC-INSTALL-STEP 6/12] Mapping GDC Companion static IP DNS overrides...
      echo "{{ companion_ip }} {{ companion_host }}" >> /etc/hosts
      echo "127.0.0.1 security.ubuntu.com" >> /etc/hosts
      echo "127.0.0.1 geoip.ubuntu.com" >> /etc/hosts
      echo "127.0.0.1 geoip.canonical.com" >> /etc/hosts
      
      # Append custom local host mappings from add-hosts
      {% if add_hosts_lines %}
      {% for line in add_hosts_lines %}
      echo "{{ line }}" >> /etc/hosts
      {% endfor %}
      {% endif %}
    - |
{% if enable_phone_home or enable_webhook %}
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Verifying connectivity to GDC Installation Companion"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Verifying connectivity to GDC Installation Companion"
      COMPANION_URL="{{ companion_url }}"
      SUCCESS=false
      for i in 1 2 3; do
        echo "[-] Attempt $i of 3: Connecting to GDC Companion at ${COMPANION_URL}..."
        if curl -s -I -H "X-Client-Cert-CN: gdc-provision-{{ ISO_VERSION }}" --connect-timeout 2 "${COMPANION_URL}" &>/dev/null; then
          echo "[-] Connection to GDC Installation Companion established successfully!"
          SUCCESS=true
          break
        fi
        if [ "$i" -lt 3 ]; then
          echo "[!] Connection failed. Retrying in 5 seconds..."
          sleep 5
        fi
      done
      if [ "${SUCCESS}" = "false" ]; then
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "[WARNING] Connectivity to GDC Installation Companion could not be verified."
        echo "[WARNING] Foregoing logging callback. Proceeding with installation..."
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        logger -p user.warning -t gdc-provisioner "[WARNING] Connectivity to GDC Installation Companion failed. Foregoing logging callback."
      fi
{% else %}
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Connectivity checking skipped (GDC_COMPANION=FALSE)"
      echo "=============================================================================="
{% endif %}
  late-commands:
    # [GDC-INSTALL-STEP 8/12] Writing target local bootstrap properties to target drive...
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Writing local bootstrap environment"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Writing local bootstrap environment to /etc/gdc/provision.yml"
      mkdir -p /target/etc/gdc
      cat <<'EOF' > /target/etc/gdc/provision.yml
      iso_version: "{{ ISO_VERSION }}"
      nexus_admin_password: "{{ TEMPORARY_INSTALLER_PASSWORD }}"
      admin_ssh_pub_keys: "{{ admin_ssh_pub_keys }}"
      temp_installer_ssh_pub_keys: "{{ temp_installer_ssh_pub_keys }}"
      {% if gdc_debug_mode and debug_extra_user %}
      debug_extra_user: "{{ debug_extra_user }}"
      {% endif %}
      EOF
      chmod 600 /target/etc/gdc/provision.yml
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Registering GDC local loopback Nexus sources"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Registering GDC local loopback Nexus sources"
      mkdir -p /target/etc/apt/sources.list.d
      cat <<'EOF' > /target/etc/apt/sources.list.d/gdc-nexus.sources
      # Local GDC Hosted (Sideloaded Update) Repository
      Enabled: yes
      Types: deb
      URIs: http://127.0.0.1:8081/repository/gdc-apt-hosted/
      Suites: noble
      Components: main restricted universe multiverse
      Signed-By: /etc/apt/keyrings/gdc-nexus.gpg
      Trusted: yes

      # Local GDC Proxy (Upstream Cache) Repository
      Enabled: yes
      Types: deb
      URIs: http://127.0.0.1:8081/repository/gdc-apt-proxy/
      Suites: noble
      Components: main restricted universe multiverse
      Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
      Trusted: yes
      EOF
      chmod 644 /target/etc/apt/sources.list.d/gdc-nexus.sources
      
      # [GDC-INSTALL-STEP 9/12] Registering loopback GDC local repository sources...
      if [ -f /target/etc/apt/sources.list.d/ubuntu.sources ]; then
        mv /target/etc/apt/sources.list.d/ubuntu.sources /target/etc/apt/sources.list.d/ubuntu.sources.bak
        logger -t gdc-provisioner "[GOAL] Default public Ubuntu sources deactivated."
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Installing pre-seeded offline Debian packages"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Installing pre-seeded offline Debian packages"
      if [ -d /cdrom/custom-data/packages ] && [ "$(ls -A /cdrom/custom-data/packages/ 2>/dev/null)" ]; then
        mkdir -p /target/var/gdc-install/packages/
        cp /cdrom/custom-data/packages/*.deb /target/var/gdc-install/packages/
        curtin in-target -- sh -c "dpkg -i /var/gdc-install/packages/*.deb || apt-get install -f -y"
        logger -t gdc-provisioner "[GOAL] Pre-seeded offline Debian packages installed and staged successfully"
      else
        logger -t gdc-provisioner "[GOAL] No pre-seeded Debian packages found, skipping"
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Copying pre-seeded offline tools"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Copying pre-seeded offline tools"
      if [ -d /cdrom/custom-data/tools ]; then
        mkdir -p /target/var/gdc-install/tools/
        cp -r /cdrom/custom-data/tools/* /target/var/gdc-install/tools/
        logger -t gdc-provisioner "[GOAL] Pre-seeded offline tools staged successfully"
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Syncing Gitea, Nexus, & Ansible collections"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Syncing Gitea, Nexus, & Ansible collections"
      mkdir -p /target/var/lib/gitea /target/var/lib/nexus /target/usr/share/ansible/collections /target/var/gdc-install/iso-cache
      
      # [GDC-INSTALL-STEP 10/12] Synchronizing Gitea, Sonatype Nexus, and Ansible collection assets...
      rsync_success=true
      rsync -a --sparse /cdrom/custom-data/gitea/ /target/var/lib/gitea/ 2>/tmp/rsync_gitea_err.log || rsync_success=false
      rsync -a --sparse /cdrom/custom-data/nexus/ /target/var/lib/nexus/ 2>/tmp/rsync_nexus_err.log || rsync_success=false
      rsync -a /cdrom/custom-data/ /target/var/gdc-install/iso-cache/ 2>/tmp/rsync_iso_cache_err.log || rsync_success=false
      
      if [ -d /cdrom/custom-data/ansible/collections ]; then
        rsync -a /cdrom/custom-data/ansible/collections/ /target/usr/share/ansible/collections/ 2>/tmp/rsync_ansible_err.log || rsync_success=false
      fi
      
      if [ "${rsync_success}" = "true" ]; then
        # Ensure correct system user, group, and permissions for Gitea (refuses to run as root)
        curtin in-target -- groupadd --system git || true
        curtin in-target -- useradd --system --shell /bin/bash --comment "Gitea Service User" --home-dir /var/lib/gitea --gid git git || true
        curtin in-target -- chown -R git:git /var/lib/gitea
        curtin in-target -- chown -R root:root /var/lib/nexus
        curtin in-target -- chown -R root:root /var/gdc-install/iso-cache
        logger -t gdc-provisioner "[GOAL] Asset synchronization completed successfully"
      else
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >/dev/ttyS0
        echo "[GDC-INSTALL-FAIL] Critical Failure: Syncing pre-seeded assets failed!" >/dev/ttyS0
        echo "Gitea rsync error:" >/dev/ttyS0
        cat /tmp/rsync_gitea_err.log >/dev/ttyS0 || true
        echo "Nexus rsync error:" >/dev/ttyS0
        cat /tmp/rsync_nexus_err.log >/dev/ttyS0 || true
        echo "Ansible collections rsync error:" >/dev/ttyS0
        cat /tmp/rsync_ansible_err.log >/dev/ttyS0 || true
        echo "ISO Cache rsync error:" >/dev/ttyS0
        cat /tmp/rsync_iso_cache_err.log >/dev/ttyS0 || true
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >/dev/ttyS0
        exit 1
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying and enabling systemd service units & timers"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying and enabling systemd service units & timers"
      cp /cdrom/custom-data/systemd/gitea.service /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/nexus.service /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/gdc-provision.service /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/gdc-provision.timer /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/gdc-desired-state.service /target/etc/systemd/system/ || true
      cp /cdrom/custom-data/systemd/gdc-desired-state.timer /target/etc/systemd/system/ || true
      curtin in-target -- systemctl enable gitea.service nexus.service gdc-provision.service gdc-provision.timer
      curtin in-target -- systemctl enable gdc-desired-state.timer || true
      curtin in-target -- git config --system --add safe.directory /var/lib/gitea/repos/gdc/bootstrap-playbooks.git || true
      curtin in-target -- git config --system --add safe.directory /var/lib/gitea/repos/gdc/system-desired-state.git || true
      curtin in-target -- git config --system --add safe.directory '*' || true
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Staging custom administrative SSH public keys"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Staging custom administrative SSH public keys for Ansible"
      ADMIN_KEYS="{{ admin_ssh_pub_keys }}"
      TEMP_KEYS="{{ temp_installer_ssh_pub_keys }}"
      
      mkdir -p /target/etc/gdc
      if [ -n "${ADMIN_KEYS}" ]; then
        echo "${ADMIN_KEYS}" > /target/etc/gdc/admin-keys.pub
        chmod 600 /target/etc/gdc/admin-keys.pub
        logger -t gdc-provisioner "[GOAL] Admin SSH keys staged successfully for Ansible execution"
      fi

      if [ -n "${TEMP_KEYS}" ]; then
        mkdir -p /target/home/temporary-installer/.ssh
        echo "${TEMP_KEYS}" >> /target/home/temporary-installer/.ssh/authorized_keys
        chmod 700 /target/home/temporary-installer/.ssh
        chmod 600 /target/home/temporary-installer/.ssh/authorized_keys
        curtin in-target -- chown -R temporary-installer:temporary-installer /home/temporary-installer/.ssh
        logger -t gdc-provisioner "[GOAL] Temporary-installer SSH keys successfully authorized"
      fi

      {% if gdc_debug_mode and debug_extra_user and debug_extra_password_hash %}
      echo "[-] [DEBUG-ISO] Provisioning Target OS extra debug user '{{ debug_extra_user }}'..."
      curtin in-target -- useradd -m -s /bin/bash -p '{{ debug_extra_password_hash }}' {{ debug_extra_user }} || curtin in-target -- usermod -p '{{ debug_extra_password_hash }}' {{ debug_extra_user }} || true
      curtin in-target -- usermod -aG sudo {{ debug_extra_user }} || true
      mkdir -p /target/etc/sudoers.d
      echo "{{ debug_extra_user }} ALL=(ALL) ALL" > /target/etc/sudoers.d/{{ debug_extra_user }}
      chmod 0440 /target/etc/sudoers.d/{{ debug_extra_user }}
      logger -t gdc-provisioner "[GOAL] Extra debug user '{{ debug_extra_user }}' provisioned on Target OS successfully"
      {% endif %}
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC Message of the Day (MOTD)"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC Message of the Day (MOTD)"
      if [ -f /cdrom/custom-data/boot-banner.txt ]; then
        cp /cdrom/custom-data/boot-banner.txt /target/etc/motd
        logger -t gdc-provisioner "[GOAL] GDC boot banner copied to MOTD successfully"
      else
        logger -t gdc-provisioner "[GOAL] Boot banner not found, skipping MOTD setup"
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC Diagnostics Collector Tool"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC Diagnostics Collector Tool"
      if [ -f /cdrom/custom-data/gdc-collector ]; then
        cp /cdrom/custom-data/gdc-collector /target/usr/local/bin/gdc-collector
        chmod +x /target/usr/local/bin/gdc-collector
        logger -t gdc-provisioner "[GOAL] Diagnostics collector tool copied to target /usr/local/bin/gdc-collector successfully"
      fi

      if [ -f /cdrom/custom-data/gdc-companion ]; then
        cp /cdrom/custom-data/gdc-companion /target/usr/local/bin/gdc-companion
        chmod +x /target/usr/local/bin/gdc-companion
        logger -t gdc-provisioner "[GOAL] Companion tool copied to target /usr/local/bin/gdc-companion successfully"
      fi
      
      if [ -f /cdrom/custom-data/scan_ips.py ]; then
        cp /cdrom/custom-data/scan_ips.py /target/usr/local/bin/scan_ips.py
        chmod +x /target/usr/local/bin/scan_ips.py
        logger -t gdc-provisioner "[GOAL] IP scanner script copied to target /usr/local/bin/scan_ips.py successfully"
      fi
      
      mkdir -p /target/usr/local/bin/auth
      if [ -f /cdrom/custom-data/auth/gcp-authentication.sh ]; then
        cp /cdrom/custom-data/auth/gcp-authentication.sh /target/usr/local/bin/auth/gcp-authentication.sh
        chmod 0755 /target/usr/local/bin/auth/gcp-authentication.sh
        logger -t gdc-provisioner "[GOAL] Authentication script copied to /target/usr/local/bin/auth/ successfully"
      fi

      mkdir -p /target/usr/local/bin/cluster /target/var/gdc-install/scripts
      if [ -f /cdrom/custom-data/cluster/create_cluster.sh ]; then
        cp /cdrom/custom-data/cluster/create_cluster.sh /target/usr/local/bin/cluster/create_cluster.sh
        chmod 0755 /target/usr/local/bin/cluster/create_cluster.sh
        logger -t gdc-provisioner "[GOAL] Cluster creation script copied to /target/usr/local/bin/cluster/ successfully"
      fi
      if [ -f /cdrom/custom-data/cluster/verify-upgrade-readiness.sh ]; then
        cp /cdrom/custom-data/cluster/verify-upgrade-readiness.sh /target/var/gdc-install/scripts/verify-upgrade-readiness.sh
        chmod 0755 /target/var/gdc-install/scripts/verify-upgrade-readiness.sh
        cp /cdrom/custom-data/cluster/verify-upgrade-readiness.sh /target/usr/local/bin/cluster/verify-upgrade-readiness.sh
        chmod 0755 /target/usr/local/bin/cluster/verify-upgrade-readiness.sh
        logger -t gdc-provisioner "[GOAL] Upgrade readiness script copied to /target/usr/local/bin/cluster/ successfully"
      fi

      mkdir -p /target/etc/profile.d
      printf '%s\n' \
        '# Add GDC categorized utility paths to PATH' \
        'if [ -d "/usr/local/bin/auth" ] && [[ ":$PATH:" != *":/usr/local/bin/auth:"* ]]; then' \
        '  PATH="$PATH:/usr/local/bin/auth"' \
        'fi' \
        'if [ -d "/usr/local/bin/cluster" ] && [[ ":$PATH:" != *":/usr/local/bin/cluster:"* ]]; then' \
        '  PATH="$PATH:/usr/local/bin/cluster"' \
        'fi' \
        'export PATH' > /target/etc/profile.d/gdc-paths.sh
      chmod 0644 /target/etc/profile.d/gdc-paths.sh
    # Ssh and passwordless root-unlock setup for transition gap
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Configuring passwordless boot-unlock key file"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Configuring passwordless boot-unlock key file"
      mkdir -p /target/etc/keys
      echo -n "temporary_bootstrap_key_to_be_enrolled_to_tpm" > /target/etc/keys/temp_key.key
      chmod 400 /target/etc/keys/temp_key.key
      
      mkdir -p /target/etc/cryptsetup-initramfs
      if [ -f /target/etc/cryptsetup-initramfs/conf-hook ]; then
        sed -i 's/#\?KEYFILE_PATTERN=.*/KEYFILE_PATTERN="\/etc\/keys\/*"/' /target/etc/cryptsetup-initramfs/conf-hook
        if ! grep -q "KEYFILE_PATTERN" /target/etc/cryptsetup-initramfs/conf-hook; then
          echo "KEYFILE_PATTERN=\"/etc/keys/*\"" >> /target/etc/cryptsetup-initramfs/conf-hook
        fi
        sed -i 's/#\?CRYPTENROLL=.*/CRYPTENROLL=y/' /target/etc/cryptsetup-initramfs/conf-hook
        if ! grep -q "CRYPTENROLL" /target/etc/cryptsetup-initramfs/conf-hook; then
          echo "CRYPTENROLL=y" >> /target/etc/cryptsetup-initramfs/conf-hook
        fi
        logger -t gdc-provisioner "[GOAL] Configured KEYFILE_PATTERN and CRYPTENROLL in cryptsetup-initramfs conf-hook"
      else
        echo "KEYFILE_PATTERN=\"/etc/keys/*\"" > /target/etc/cryptsetup-initramfs/conf-hook
        echo "CRYPTENROLL=y" >> /target/etc/cryptsetup-initramfs/conf-hook
        logger -t gdc-provisioner "[GOAL] Created cryptsetup-initramfs conf-hook with KEYFILE_PATTERN and CRYPTENROLL"
      fi
      
      echo -n "temporary_bootstrap_key_to_be_enrolled_to_tpm" > /target/tmp/pass.txt
      # Resolve LUKS devices either using blkid or by querying active cryptsetup mappings in crypttab
      LUKS_DEVS=$(blkid -t TYPE=crypto_LUKS -o device)
      if [ -z "${LUKS_DEVS}" ] && [ -f /target/etc/crypttab ]; then
        logger -t gdc-provisioner "[INFO] blkid cache stale or empty. Querying active cryptsetup mappings for LUKS devices..."
        while read -r name dev key options; do
          case "${name}" in
            ""|\#*) continue ;;
          esac
          phys_dev=$(cryptsetup status "${name}" 2>/dev/null | grep "device:" | awk '{print $2}')
          if [ -n "${phys_dev}" ] && [ -b "${phys_dev}" ]; then
            logger -t gdc-provisioner "[INFO] Resolved active mapping '${name}' to physical device '${phys_dev}'"
            LUKS_DEVS="${LUKS_DEVS} ${phys_dev}"
          fi
        done < /target/etc/crypttab
      fi

      if [ -n "${LUKS_DEVS}" ]; then
        for crypt_dev in ${LUKS_DEVS}; do
          logger -t gdc-provisioner "[GOAL] Adding key to LUKS device ${crypt_dev}..."
          if curtin in-target -- cryptsetup luksAddKey --key-file=/tmp/pass.txt "${crypt_dev}" /etc/keys/temp_key.key; then
            logger -t gdc-provisioner "[GOAL] Added key to LUKS device ${crypt_dev}"
          else
            echo "[GDC-INSTALL-FAIL] Critical Failure: Failed to add key to LUKS device ${crypt_dev}!"
            exit 1
          fi
        done
        sed -Ei 's/[[:space:]]+none[[:space:]]+/ \/etc\/keys\/temp_key.key /g' /target/etc/crypttab
        logger -t gdc-provisioner "[GOAL] Updated crypttab to use key file on all partitions"
      else
        logger -t gdc-provisioner "[GOAL] No LUKS devices found, skipping key enrollment"
      fi
      rm -f /target/tmp/pass.txt
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC SSH configurations"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC SSH configurations"
      mkdir -p /target/etc/ssh/sshd_config.d
      echo "# Disable reverse DNS lookups to prevent connection hangs in air-gapped segments" > /target/etc/ssh/sshd_config.d/gdc.conf
      echo "UseDNS no" >> /target/etc/ssh/sshd_config.d/gdc.conf
      logger -t gdc-provisioner "[GOAL] SSH UseDNS configuration created successfully"
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC Production VRF Netplan configuration"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC Production VRF Netplan configuration"
      
      # Invoke the safe structured Python network compiler
      mkdir -p /target/var/gdc-install/logs /target/var/log
      ln -sf /var/gdc-install/logs/netplan-hydration.log /target/var/log/netplan-hydration.log
      if python3 /cdrom/custom-data/configure_netplan.py >/target/var/gdc-install/logs/netplan-hydration.log 2>&1; then
        logger -t gdc-provisioner "[GOAL] GDC Production VRF Netplan compiled and validated successfully."
      else
        echo "[GDC-INSTALL-FAIL] Critical Failure: Programmatic Netplan compilation failed! Diagnostics written to /target/var/gdc-install/logs/netplan-hydration.log" >/dev/ttyS0
        cat /target/var/gdc-install/logs/netplan-hydration.log >/dev/ttyS0 || true
        exit 1
      fi
      
      # Redirect security upgrades to loopback to prevent long hangs during curtin installation
      echo "127.0.0.1 security.ubuntu.com" >> /target/etc/hosts
      echo "127.0.0.1 geoip.ubuntu.com" >> /target/etc/hosts
      echo "127.0.0.1 geoip.canonical.com" >> /target/etc/hosts
      
      # Dynamically configure unique hostname based on primary network interface MAC address
      PHYS_IFACE=$(ls /sys/class/net | grep -E '^e' | head -n 1 || echo "eth0")
      MAC_ADDR=$(cat /sys/class/net/${PHYS_IFACE}/address | tr -d ':')
      MAC_SUFFIX=$(echo -n "${MAC_ADDR}" | tail -c 4)
      NEW_HOSTNAME="gdc-standalone-node-${MAC_SUFFIX}"
      echo "${NEW_HOSTNAME}" > /target/etc/hostname
      
      # Write the structured JSON machine configuration for isolated fallback
      # if the GDC Companion API is unreachable.
      cat << 'EOF' > /target/etc/gdc/fallback-config.json
      {
        "is_fallback": true,
        "hostname": "{{ bootstrap_host_name }}",
        "machine_state_stop_stage": "{{ fallback_machine_state_stop_stage }}",
        "gdc_debug_mode": {{ gdc_debug_mode | lower }},
        "bmctl_version": "{{ bootstrap_bmctl_version }}",
        "network": {
          "management_network": {
            "dhcp_v4": true
          },
          "cluster_network": {
            "dhcp_v4": true,
            "vlan_id": {{ fallback_cluster_vlan_id }}
          }
        },
        "peers": {{ fallback_peers_json }},
        "gcp_info": {
          "project_id": "{{ fallback_gcp_project_id }}",
          "region": "{{ fallback_gcp_region }}",
          "primary_gsa": "{{ fallback_gcp_primary_gsa }}"
        }
      }
      EOF
      
      # Ensure local hostname and GDC companion gateway mappings are present in /etc/hosts to prevent resolver hangs on boot
      echo "127.0.1.1 ${NEW_HOSTNAME}" >> /target/etc/hosts
      echo "{{ companion_ip }} {{ companion_host }}" >> /target/etc/hosts
      
      # Append custom local host mappings from add-hosts to target OS
      {% if persist_add_hosts and add_hosts_lines %}
      {% for line in add_hosts_lines %}
      echo "{{ line }}" >> /target/etc/hosts
      {% endfor %}
      {% endif %}
      
      # Purge cloud-init and its dependent meta-packages (ubuntu-server, ubuntu-server-minimal) to prevent unmet dependency deadlocks on boot
      logger -t gdc-provisioner "[GOAL] Purging cloud-init and server meta-packages on target OS"
      mkdir -p /target/etc/cloud
      touch /target/etc/cloud/cloud-init.disabled
      curtin in-target -- apt-get purge -y cloud-init ubuntu-server ubuntu-server-minimal || true
      rm -f /target/etc/issue.d/*cloud-init* || true
      rm -f /target/etc/issue.d/* || true
      
      # Disable unattended-upgrades on target OS to prevent first-boot package manager locks
      logger -t gdc-provisioner "[GOAL] Disabling unattended-upgrades on target OS"
      curtin in-target -- systemctl disable apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service || true
      curtin in-target -- systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service || true
      curtin in-target -- systemctl mask apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service || true
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Configuring VRF sysctl profiles"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Configuring VRF sysctl profiles"
      mkdir -p /target/etc/sysctl.d
      echo "net.ipv4.tcp_l3mdev_accept=1" > /target/etc/sysctl.d/99-vrf.conf
      echo "net.ipv4.udp_l3mdev_accept=1" >> /target/etc/sysctl.d/99-vrf.conf
      logger -t gdc-provisioner "[GOAL] VRF sysctl profiles configured successfully"
      
      IS_AMD=false
      if grep -qi "AuthenticAMD" /proc/cpuinfo; then
        IS_AMD=true
        logger -t gdc-provisioner "[GOAL] AMD platform detected: deploying kernel module blacklist to prevent fTPM conflicts"
        mkdir -p /target/etc/modprobe.d
        echo "blacklist pcie_mp2_amd" > /target/etc/modprobe.d/gdc-blacklist.conf
        echo "blacklist amd_sfh" >> /target/etc/modprobe.d/gdc-blacklist.conf
        echo "blacklist ccp" >> /target/etc/modprobe.d/gdc-blacklist.conf
        logger -t gdc-provisioner "[GOAL] Kernel module blacklist deployed successfully"
      else
        logger -t gdc-provisioner "[GOAL] Non-AMD platform detected (Intel/Other): skipping AMD driver blacklist"
        rm -f /target/etc/modprobe.d/gdc-blacklist.conf
      fi
      
      logger -t gdc-provisioner "[GOAL] Configuring target GRUB bootloader parameters"
      if [ -f /target/etc/default/grub ]; then
        # Dynamically extract the UUID of the physical LUKS partition to explicitly instruct dracut to unseal it
        # This resolves the issue where dracut systemd generators ignore encrypted volumes that contain the LVM root partition.
        LUKS_UUID=$(blkid -s UUID -o value -t TYPE=crypto_LUKS | head -n 1)
        
        PLATFORM_PARAMS=""
        if [ "$IS_AMD" = "true" ]; then
          PLATFORM_PARAMS="tpm_tis.interrupts=0 modprobe.blacklist=pcie_mp2_amd,amd_sfh,ccp"
        fi
        
        TARGET_CMDLINE="console=tty1 console=ttyS0,115200 systemd.log_level=info ${PLATFORM_PARAMS} video=efifb:1280x1024"
        if [ -n "${LUKS_UUID}" ]; then
          echo "[-] Discovered primary LUKS partition UUID: ${LUKS_UUID}"
          TARGET_CMDLINE="${TARGET_CMDLINE} rd.luks.uuid=luks-${LUKS_UUID}"
        fi
        
        sed -i "s/GRUB_CMDLINE_LINUX_DEFAULT=\".*\"/GRUB_CMDLINE_LINUX_DEFAULT=\"${TARGET_CMDLINE}\"/g" /target/etc/default/grub
        
        # Enable GRUB boot menu interaction over serial console and configure 5s timeout with GDC branding
        sed -i 's/GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/g' /target/etc/default/grub
        sed -i 's/GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=menu/g' /target/etc/default/grub
        sed -i 's/GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="GDC Ubuntu [default]"/g' /target/etc/default/grub
        echo 'GRUB_TERMINAL="console serial"' >> /target/etc/default/grub
        echo 'GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"' >> /target/etc/default/grub
        curtin in-target -- update-grub || true
        logger -t gdc-provisioner "[GOAL] Target GRUB command line updated successfully"

        # Apply standard GDC Boot Order Policy: set SSD as primary UEFI boot target after LiveCD installation
        logger -t gdc-provisioner "[GOAL] Applying standard UEFI boot re-ordering to prioritize local disk"
        if [ -d /sys/firmware/efi ]; then
          if command -v efibootmgr &>/dev/null; then
            # Identify the target local disk EFI boot option (matching GDC, ubuntu, NVMe, or SATA)
            BOOT_NUM=$(efibootmgr | grep -i "GDC" | head -n 1 | awk '{print $1}' | sed 's/Boot//g' | tr -d '*' | tr -d ':')
            if [ -z "${BOOT_NUM}" ]; then
              BOOT_NUM=$(efibootmgr | grep -i "ubuntu" | head -n 1 | awk '{print $1}' | sed 's/Boot//g' | tr -d '*' | tr -d ':')
            fi
            if [ -z "${BOOT_NUM}" ]; then
              BOOT_NUM=$(efibootmgr | grep -i "NVMe" | head -n 1 | awk '{print $1}' | sed 's/Boot//g' | tr -d '*' | tr -d ':')
            fi
            if [ -z "${BOOT_NUM}" ]; then
              BOOT_NUM=$(efibootmgr | grep -i "SATA" | head -n 1 | awk '{print $1}' | sed 's/Boot//g' | tr -d '*' | tr -d ':')
            fi
            
            if [ -n "${BOOT_NUM}" ]; then
              CURRENT_ORDER=$(efibootmgr | grep "BootOrder:" | cut -d' ' -f2)
              # Clean current order removing the target boot entry
              CLEANED_ORDER=$(echo "${CURRENT_ORDER}" | sed "s/${BOOT_NUM}//g" | sed "s/,,/,/g" | sed "s/^,//g" | sed "s/,$//g")
              if [ -n "${CLEANED_ORDER}" ]; then
                NEW_ORDER="${BOOT_NUM},${CLEANED_ORDER}"
              else
                NEW_ORDER="${BOOT_NUM}"
              fi
              echo "[-] Standardized boot order policy: setting local disk (${BOOT_NUM}) as default boot option. New Order: ${NEW_ORDER}"
              efibootmgr -o "${NEW_ORDER}" || true
              logger -t gdc-provisioner "[GOAL] UEFI BootOrder reconfigured successfully to prioritize local disk boot: ${NEW_ORDER}"
            else
              echo "[WARNING] Could not identify local disk UEFI boot entry. Leaving boot order unchanged."
              logger -t gdc-provisioner "[WARNING] Could not identify local disk UEFI boot entry."
            fi
          else
            echo "[WARNING] efibootmgr is not available in the Live CD environment. Skipping boot reordering."
            logger -t gdc-provisioner "[WARNING] efibootmgr missing. Boot reordering skipped."
          fi
        else
          echo "[-] Non-UEFI/Legacy BIOS boot mode active. Skipping UEFI boot reordering."
        fi
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Rebuilding systemd-based initramfs"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Rebuilding systemd-based initramfs"
      
      IS_AMD=false
      if grep -qi "AuthenticAMD" /proc/cpuinfo; then
        IS_AMD=true
      fi
      
      # Bind mount virtual filesystems to allow chroot processes to access device maps and kernel interfaces
      mount -o bind /dev /target/dev || true
      mount -t proc none /target/proc || true
      mount -t sysfs none /target/sys || true
      
      # Configure all unpacked but unconfigured packages inside the target to fire triggers cleanly
      curtin in-target -- dpkg --configure -a || true
      
      # Deploy persistent dracut configuration so future kernel upgrades (e.g. apt-get upgrade) retain mandatory GDC drivers and modules
      mkdir -p /target/etc/dracut.conf.d
      if [ "$IS_AMD" = "true" ]; then
        printf '%s\n' \
          '# Persistent GDC Dracut configuration (AMD Platform)' \
          'omit_drivers+=" pcie_mp2_amd amd_sfh ccp "' \
          'add_dracutmodules+=" crypt lvm tpm2-tss "' \
          'add_drivers+=" tpm tpm_tis tpm_crb tpm_tis_core "' \
          'hostonly="no"' \
          > /target/etc/dracut.conf.d/gdc.conf
      else
        printf '%s\n' \
          '# Persistent GDC Dracut configuration (Intel/Generic Platform)' \
          'add_dracutmodules+=" crypt lvm tpm2-tss "' \
          'add_drivers+=" tpm tpm_tis tpm_crb tpm_tis_core "' \
          'hostonly="no"' \
          > /target/etc/dracut.conf.d/gdc.conf
      fi
      logger -t gdc-provisioner "[GOAL] Persistent dracut configuration deployed to /target/etc/dracut.conf.d/gdc.conf"
      
      # Deploy the initramfs-tools hook to physically delete fTPM-deadlocking drivers from compilation staging on AMD
      if [ "$IS_AMD" = "true" ]; then
        mkdir -p /target/etc/initramfs-tools/hooks
        printf '%s\n' \
          '#!/bin/sh' \
          'PREREQ=""' \
          'prereqs() {' \
          '    echo "$PREREQ"' \
          '}' \
          'case "$1" in' \
          '    prereqs)' \
          '        prereqs' \
          '        exit 0' \
          '        ;;' \
          'esac' \
          '' \
          '. /usr/share/initramfs-tools/hook-functions' \
          '' \
          '# Count matching files before pruning' \
          'files_to_prune=$(find "${DESTDIR}" -name "*amd_sfh*" -o -name "*pcie_mp2_amd*" -o -name "*ccp*")' \
          'num_found=0' \
          'if [ -n "${files_to_prune}" ]; then' \
          '    num_found=$(echo "${files_to_prune}" | wc -l)' \
          'fi' \
          'echo "[-] Found ${num_found} blacklisted deadlock drivers in initramfs staging. Pruning..."' \
          '' \
          '# Perform the deletion sweep' \
          'find "${DESTDIR}" -name "*amd_sfh*" -delete' \
          'find "${DESTDIR}" -name "*pcie_mp2_amd*" -delete' \
          'find "${DESTDIR}" -name "*ccp*" -delete' \
          '' \
          '# Assert that no blacklisted drivers remain in the staging directory' \
          'remaining_files=$(find "${DESTDIR}" -name "*amd_sfh*" -o -name "*pcie_mp2_amd*" -o -name "*ccp*")' \
          'if [ -n "${remaining_files}" ]; then' \
          '    echo "[!] CRITICAL ERROR: Failed to prune deadlock drivers from initramfs staging directory!" >&2' \
          '    echo "${remaining_files}" >&2' \
          '    exit 1' \
          'fi' \
          'echo "[+] Verification successful: 0 blacklisted deadlock drivers remain in initramfs staging directory."' \
          > /target/etc/initramfs-tools/hooks/zz-gdc-blacklist
        chmod +x /target/etc/initramfs-tools/hooks/zz-gdc-blacklist
        logger -t gdc-provisioner "[GOAL] Custom initramfs-tools hook deployed successfully to prune deadlock drivers"
      fi
      
      # Determine highest kernel version installed in /target
      TARGET_KERNEL=$(ls -1 /target/lib/modules | sort -V | tail -n 1)
      if [ -z "${TARGET_KERNEL}" ]; then
        echo "[GDC-INSTALL-FAIL] Critical Failure: TARGET_KERNEL is empty!" >/dev/ttyS0
        exit 1
      fi
      echo "[-] Rebuilding initramfs for kernel version: ${TARGET_KERNEL}"
      
      if curtin in-target -- update-initramfs -c -k "${TARGET_KERNEL}" || curtin in-target -- update-initramfs -u -k "${TARGET_KERNEL}"; then
        echo "=============================================================================="
        echo "[GDC-INSTALL-GOAL] Rebuilding initramfs succeeded"
        echo "=============================================================================="
        logger -t gdc-provisioner "[GOAL] Rebuilding initramfs succeeded"
      else
        echo "[GDC-INSTALL-FAIL] Critical Failure: Rebuilding initramfs failed!"
        umount -l /target/proc 2>/dev/null || true
        umount -l /target/sys 2>/dev/null || true
        umount -l /target/dev 2>/dev/null || true
        exit 1
      fi
      
      umount -l /target/proc 2>/dev/null || true
      umount -l /target/sys 2>/dev/null || true
      umount -l /target/dev 2>/dev/null || true

      # --- INITRAMFS READINESS VALIDATION ---
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Validating generated initramfs contents"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Validating generated initramfs contents"
      
      INITRD_FILE=$(ls -t /target/boot/initrd.img-* | head -n 1)
      if [ -n "${INITRD_FILE}" ]; then
        echo "[-] Found newly generated initrd: ${INITRD_FILE}"
        
        # Assertion 1: Transition key is present (allows passwordless first boot)
        if curtin in-target -- lsinitramfs "${INITRD_FILE#/target}" | grep -q -E "temp_key\.key|crypt-system\.key"; then
          logger -t gdc-provisioner "[GOAL] VALIDATION SUCCESS: Plaintext transition key packaged inside initrd."
          echo "    [+] Success: Plaintext transition key packaged inside initrd."
        else
          echo "[GDC-INSTALL-FAIL] Critical Failure: Transition key was NOT packaged inside initrd!" >/dev/ttyS0
          exit 1
        fi
        
        # Assertion 2: Crypt/cryptsetup module is present (enables decryption engine)
        if curtin in-target -- lsinitramfs "${INITRD_FILE#/target}" | grep -q -E "cryptsetup|crypt"; then
          logger -t gdc-provisioner "[GOAL] VALIDATION SUCCESS: Crypt/cryptsetup module present."
          echo "    [+] Success: Crypt/cryptsetup module present in initrd."
        else
          echo "[GDC-INSTALL-FAIL] Critical Failure: Crypt module missing from initrd!" >/dev/ttyS0
          exit 1
        fi
        
        # Assertion 3: LVM module is present (enables mapping of lv_root)
        if curtin in-target -- lsinitramfs "${INITRD_FILE#/target}" | grep -q -E "lvm|lvm2"; then
          logger -t gdc-provisioner "[GOAL] VALIDATION SUCCESS: LVM module present."
          echo "    [+] Success: LVM module present in initrd."
        else
          echo "[GDC-INSTALL-FAIL] Critical Failure: LVM module missing from initrd!" >/dev/ttyS0
          exit 1
        fi
        
        # Assertion 4: Physical storage controller drivers are present
        if curtin in-target -- lsinitramfs "${INITRD_FILE#/target}" | grep -q -E "nvme|ahci"; then
          logger -t gdc-provisioner "[GOAL] VALIDATION SUCCESS: NVMe/SATA controller drivers present."
          echo "    [+] Success: NVMe/SATA controller drivers present."
        else
          echo "[GDC-INSTALL-FAIL] Critical Failure: NVMe/SATA drivers missing from initrd!" >/dev/ttyS0
          exit 1
        fi
        
        # Assertion 5: Deadlock drivers are omitted on AMD platforms
        if [ "$IS_AMD" = "true" ]; then
          if curtin in-target -- lsinitramfs "${INITRD_FILE#/target}" | grep -q -E "pcie_mp2_amd|amd_sfh"; then
            echo "[GDC-INSTALL-FAIL] Critical Failure: Blacklisted AMD Sensor Fusion Hub drivers compiled into initrd!" >/dev/ttyS0
            exit 1
          else
            logger -t gdc-provisioner "[GOAL] VALIDATION SUCCESS: Deadlock drivers omitted from initrd."
            echo "    [+] Success: Deadlock drivers omitted from initrd."
          fi
        else
          logger -t gdc-provisioner "[GOAL] VALIDATION SUCCESS: Non-AMD platform (skipping AMD driver omission assertion)."
          echo "    [+] Success: Non-AMD platform (skipping AMD driver omission assertion)."
        fi
      else
        echo "[GDC-INSTALL-FAIL] Critical Failure: No initrd file found in /target/boot/!" >/dev/ttyS0
        exit 1
      fi
      
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] All custom late commands succeeded and validated!"
      echo "=============================================================================="
