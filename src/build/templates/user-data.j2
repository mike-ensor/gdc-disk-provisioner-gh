#cloud-config
autoinstall:
  version: 1
  reboot: true
  apt:
    unattended-upgrades:
      enabled: false
  storage:
{{ storage_config }}
  identity:
    hostname: gdc-standalone-node
    username: temporary-installer
    password: "{{ password_hash }}"
  locale: en_US.UTF-8
  keyboard: {layout: us}
  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "e*"
        dhcp4: true
  ssh:
    install-server: true
    allow-pw: true
    {% if ssh_pub_key %}
    authorized-keys:
      - "{{ ssh_pub_key }}"
    {% endif %}
  packages:
    - ansible
    - git
  reporting:
    gdc-gateway:
      type: webhook
      endpoint: {{ companion_report_url }}?client_cert_cn=gdc-provision-{{ ISO_VERSION }}
      level: info
  early-commands:
    - |
      # Live-stream Subiquity server logs to serial console for real-time diagnostics
      touch /var/log/installer/subiquity-server-debug.log
      tail -f /var/log/installer/subiquity-server-debug.log > /dev/ttyS0 2>/dev/null &
    - |
      # If GDC Debug Mode is active, enable Live CD SSH Password logins (GDC-DEBUG-ONLY)
      {% if gdc_debug_mode %}
      echo "[-] [DEBUG-ISO] Configuring Live CD Root passworded SSH entry..."
      echo "root:gdc-password-123" | chpasswd
      echo "ubuntu:gdc-password-123" | chpasswd
      sed -i 's/#\?PasswordAuthentication.*/PasswordAuthentication yes/g' /etc/ssh/sshd_config
      sed -i 's/#\?PermitRootLogin.*/PermitRootLogin yes/g' /etc/ssh/sshd_config
      systemctl restart ssh || systemctl restart sshd
      {% endif %}
      
      # Set up the Diagnostics script as a globally executable utility on the Live CD
      if [ -f /cdrom/custom-data/collect-node-diagnostics.sh ]; then
        cp /cdrom/custom-data/collect-node-diagnostics.sh /usr/local/bin/collect-node-diagnostics.sh
        chmod +x /usr/local/bin/collect-node-diagnostics.sh
        echo "[-] Diagnostics tool registered as globally executable: 'collect-node-diagnostics.sh'"
      fi
    - |
      # Dynamic storage configuration generation and merging (GDC-SPEC-002-SEQ)
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Dynamically configuring LVM storage layout"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Dynamically configuring LVM storage layout"
      if [ -f /cdrom/custom-data/generate_storage_config.sh ]; then
        cp /cdrom/custom-data/generate_storage_config.sh /tmp/generate_storage_config.sh
        chmod +x /tmp/generate_storage_config.sh
        if /tmp/generate_storage_config.sh; then
          echo "[-] Storage configuration generated successfully."
          if python3 -c "import os, yaml; bp = '/cdrom/nocloud/user-data' if os.path.exists('/cdrom/nocloud/user-data') else '/run/installer/autoinstall-user-data'; c = yaml.safe_load(open(bp)); s = yaml.safe_load(open('/run/autoinstall-storage.yaml')); c['autoinstall']['storage'] = s['storage']; yaml.safe_dump(c, open('/autoinstall.yaml', 'w')); os.makedirs('/run/installer', exist_ok=True); yaml.safe_dump(c, open('/run/installer/autoinstall-user-data', 'w'))"; then
            logger -t gdc-provisioner "[GOAL] LVM storage layout merged dynamically successfully."
          else
            echo "[GDC-INSTALL-FAIL] Critical Failure: Dynamic storage config merger failed!" >/dev/ttyS0
            exit 1
          fi
        else
          echo "[GDC-INSTALL-FAIL] Critical Failure: Dynamic storage config generator failed!" >/dev/ttyS0
          exit 1
        fi
      else
        echo "[!] Warning: Dynamic storage config generator not found on ISO! Falling back to static build config."
      fi
    - |
      # Print GDC vintage parchment boot banner with version and build timestamp
      if [ -f /cdrom/custom-data/boot-banner.txt ]; then
        cat /cdrom/custom-data/boot-banner.txt > /dev/ttyS0 2>/dev/null || true
        cat /cdrom/custom-data/boot-banner.txt > /dev/console 2>/dev/null || true
        cat /cdrom/custom-data/boot-banner.txt
      fi
    - |
      # Stop and mask unattended-upgrades on the live installer to prevent installation delays
      systemctl stop unattended-upgrades || true
      systemctl mask unattended-upgrades || true
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Activating Live ISO network segment"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Activating Live ISO network segment"
      PHYS_IFACE=$(ls /sys/class/net | grep -E '^e' | head -n 1 || echo "eth0")
      
      # Configure Live ISO network interface based on VLAN ID using DHCP
      VLAN_ID="{{ machine_vlan }}"
      if [ -z "${VLAN_ID}" ] || [ "${VLAN_ID}" = "0" ]; then
        # Untagged native configuration (directly on physical interface!)
        echo "[-] Running on untagged native network. Retaining existing DHCP configuration."
        ip link set dev "${PHYS_IFACE}" up || true
      else
        # Tagged VLAN configuration
        echo "[-] Running on tagged VLAN ${VLAN_ID}. Activating VLAN interface..."
        ip link add link "${PHYS_IFACE}" name "${PHYS_IFACE}.${VLAN_ID}" type vlan id "${VLAN_ID}" 2>/dev/null || true
        ip link set dev "${PHYS_IFACE}.${VLAN_ID}" up || true
        echo "[-] Requesting DHCP address on VLAN interface..."
        dhclient "${PHYS_IFACE}.${VLAN_ID}" 2>/dev/null || systemctl restart systemd-networkd || true
      fi
      
      # Add static DNS host mapping for GDC Companion resolving and block security upgrades
      echo "{{ companion_ip }} {{ companion_host }}" >> /etc/hosts
      echo "127.0.0.1 security.ubuntu.com" >> /etc/hosts
      echo "127.0.0.1 geoip.ubuntu.com" >> /etc/hosts
      echo "127.0.0.1 geoip.canonical.com" >> /etc/hosts
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Verifying connectivity to GDC Installation Companion"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Verifying connectivity to GDC Installation Companion"
      COMPANION_URL="{{ companion_url }}"
      SUCCESS=false
      for i in 1 2 3; do
        echo "[-] Attempt $i of 3: Connecting to GDC Companion at ${COMPANION_URL}..."
        if curl -s -I -H "X-Client-Cert-CN: gdc-provision-{{ ISO_VERSION }}" --connect-timeout 2 "${COMPANION_URL}" &>/dev/null; then
          echo "[-] Connection to GDC Installation Companion established successfully!"
          SUCCESS=true
          break
        fi
        if [ "$i" -lt 3 ]; then
          echo "[!] Connection failed. Retrying in 5 seconds..."
          sleep 5
        fi
      done
      if [ "${SUCCESS}" = "false" ]; then
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "[WARNING] Connectivity to GDC Installation Companion could not be verified."
        echo "[WARNING] Foregoing logging callback. Proceeding with installation..."
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        logger -p user.warning -t gdc-provisioner "[WARNING] Connectivity to GDC Installation Companion failed. Foregoing logging callback."
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Scanning for free Machine & Kubernetes IPs"
      echo "=============================================================================="
      PHYS_IFACE=$(ls /sys/class/net | grep -E '^e' | head -n 1 || echo "eth0")
      
      # Ensure arp-scan and net-tools are dynamically bootstrapped in live environment (connected mode)
      if ! command -v arp-scan &>/dev/null; then
        echo "[-] Sideloading net-tools & arp-scan packages in live environment..."
        apt-get update &>/dev/null && apt-get install -y arp-scan net-tools &>/dev/null || true
      fi

      # Invoke the robust splay python IP scanner
      python3 /cdrom/custom-data/scan_ips.py --cidr "192.168.9.8/29" --interface "${PHYS_IFACE}" --fallback "192.168.9.14" --output "/tmp/allocated_ips.env" --machine-cidr "{{ machine_ip_cidr }}" --k8s-cidr "{{ k8s_ip_cidr }}"
  late-commands:
    # Sync pre-seeded assets cleanly and set up service persistent storage
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Writing local bootstrap environment"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Writing local bootstrap environment to /etc/gdc/provision.yml"
      mkdir -p /target/etc/gdc
      cat <<'EOF' > /target/etc/gdc/provision.yml
      nexus_admin_password: "{{ TEMPORARY_INSTALLER_PASSWORD }}"
      ssh_pub_key: "{{ ssh_pub_key }}"
      EOF
      chmod 600 /target/etc/gdc/provision.yml
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Syncing Gitea, Nexus, & Ansible collections"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Syncing Gitea, Nexus, & Ansible collections"
      mkdir -p /target/var/lib/gitea /target/var/lib/nexus /target/usr/share/ansible/collections
      
      # Execute rsync while capturing standard error to temporary logs for diagnostics
      rsync_success=true
      rsync -a --sparse /cdrom/custom-data/gitea/ /target/var/lib/gitea/ 2>/tmp/rsync_gitea_err.log || rsync_success=false
      rsync -a --sparse /cdrom/custom-data/nexus/ /target/var/lib/nexus/ 2>/tmp/rsync_nexus_err.log || rsync_success=false
      
      if [ -d /cdrom/custom-data/ansible/collections ]; then
        rsync -a /cdrom/custom-data/ansible/collections/ /target/usr/share/ansible/collections/ 2>/tmp/rsync_ansible_err.log || rsync_success=false
      fi
      
      if [ "${rsync_success}" = "true" ]; then
        # Ensure correct system user, group, and permissions for Gitea (refuses to run as root)
        curtin in-target -- groupadd --system git || true
        curtin in-target -- useradd --system --shell /bin/bash --comment "Gitea Service User" --home-dir /var/lib/gitea --gid git git || true
        curtin in-target -- chown -R git:git /var/lib/gitea
        curtin in-target -- chown -R root:root /var/lib/nexus
        logger -t gdc-provisioner "[GOAL] Asset synchronization completed successfully"
      else
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >/dev/ttyS0
        echo "[GDC-INSTALL-FAIL] Critical Failure: Syncing pre-seeded assets failed!" >/dev/ttyS0
        echo "Gitea rsync error:" >/dev/ttyS0
        cat /tmp/rsync_gitea_err.log >/dev/ttyS0 || true
        echo "Nexus rsync error:" >/dev/ttyS0
        cat /tmp/rsync_nexus_err.log >/dev/ttyS0 || true
        echo "Ansible collections rsync error:" >/dev/ttyS0
        cat /tmp/rsync_ansible_err.log >/dev/ttyS0 || true
        echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >/dev/ttyS0
        exit 1
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying and enabling systemd service units & timers"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying and enabling systemd service units & timers"
      cp /cdrom/custom-data/systemd/gitea.service /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/nexus.service /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/gdc-provision.service /target/etc/systemd/system/
      cp /cdrom/custom-data/systemd/gdc-provision.timer /target/etc/systemd/system/
      curtin in-target -- systemctl enable gitea.service nexus.service gdc-provision.service gdc-provision.timer
      curtin in-target -- git config --system --add safe.directory /var/lib/gitea/repos/gdc/bootstrap-playbooks.git || true
      curtin in-target -- git config --system --add safe.directory '*' || true
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Injecting custom administrative SSH public keys"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Injecting custom administrative SSH public keys"
      PUB_KEY="{{ ssh_pub_key }}"
      if [ -n "${PUB_KEY}" ]; then
        mkdir -p /target/root/.ssh /target/home/temporary-installer/.ssh
        echo "${PUB_KEY}" >> /target/root/.ssh/authorized_keys
        echo "${PUB_KEY}" >> /target/home/temporary-installer/.ssh/authorized_keys
        chmod 700 /target/root/.ssh /target/home/temporary-installer/.ssh
        chmod 600 /target/root/.ssh/authorized_keys /target/home/temporary-installer/.ssh/authorized_keys
        curtin in-target -- chown -R temporary-installer:temporary-installer /home/temporary-installer/.ssh
        logger -t gdc-provisioner "[GOAL] SSH public keys successfully authorized"
      else
        logger -t gdc-provisioner "[GOAL] No custom SSH public keys configured, skipping injection"
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC Message of the Day (MOTD)"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC Message of the Day (MOTD)"
      if [ -f /cdrom/custom-data/boot-banner.txt ]; then
        cp /cdrom/custom-data/boot-banner.txt /target/etc/motd
        logger -t gdc-provisioner "[GOAL] GDC boot banner copied to MOTD successfully"
      else
        logger -t gdc-provisioner "[GOAL] Boot banner not found, skipping MOTD setup"
      fi
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC Diagnostics Collector Tool"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC Diagnostics Collector Tool"
      if [ -f /cdrom/custom-data/collect-node-diagnostics.sh ]; then
        cp /cdrom/custom-data/collect-node-diagnostics.sh /target/usr/local/bin/collect-node-diagnostics.sh
        chmod +x /target/usr/local/bin/collect-node-diagnostics.sh
        logger -t gdc-provisioner "[GOAL] Diagnostics collector tool copied to target /usr/local/bin/collect-node-diagnostics.sh successfully"
      fi
    # Ssh and passwordless root-unlock setup for transition gap
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Configuring passwordless boot-unlock key file"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Configuring passwordless boot-unlock key file"
      mkdir -p /target/etc/keys
      echo -n "temporary_bootstrap_key_to_be_enrolled_to_tpm" > /target/etc/keys/temp_key.key
      chmod 400 /target/etc/keys/temp_key.key
      mkdir -p /target/etc/cryptsetup-initramfs
      if [ -f /target/etc/cryptsetup-initramfs/conf-hook ]; then
        sed -i 's/#\?KEYFILE_PATTERN=.*/KEYFILE_PATTERN="\/etc\/keys\/*"/' /target/etc/cryptsetup-initramfs/conf-hook
        if ! grep -q "KEYFILE_PATTERN" /target/etc/cryptsetup-initramfs/conf-hook; then
          echo "KEYFILE_PATTERN=\"/etc/keys/*\"" >> /target/etc/cryptsetup-initramfs/conf-hook
        fi
        logger -t gdc-provisioner "[GOAL] Configured KEYFILE_PATTERN in cryptsetup-initramfs conf-hook"
      else
        echo "KEYFILE_PATTERN=\"/etc/keys/*\"" > /target/etc/cryptsetup-initramfs/conf-hook
        logger -t gdc-provisioner "[GOAL] Created cryptsetup-initramfs conf-hook with KEYFILE_PATTERN"
      fi
      echo -n "temporary_bootstrap_key_to_be_enrolled_to_tpm" > /tmp/pass.txt
      LUKS_DEVS=$(blkid -t TYPE=crypto_LUKS -o device)
      if [ -n "${LUKS_DEVS}" ]; then
        for crypt_dev in ${LUKS_DEVS}; do
          logger -t gdc-provisioner "[GOAL] Adding key to LUKS device ${crypt_dev}..."
          if cryptsetup luksAddKey --key-file=/tmp/pass.txt "${crypt_dev}" /target/etc/keys/temp_key.key; then
            logger -t gdc-provisioner "[GOAL] Added key to LUKS device ${crypt_dev}"
          else
            echo "[GDC-INSTALL-FAIL] Critical Failure: Failed to add key to LUKS device ${crypt_dev}!"
            exit 1
          fi
        done
        sed -Ei 's/[[:space:]]+none[[:space:]]+/ \/etc\/keys\/temp_key.key /g' /target/etc/crypttab
        logger -t gdc-provisioner "[GOAL] Updated crypttab to use key file on all partitions"
      else
        logger -t gdc-provisioner "[GOAL] No LUKS devices found, skipping key enrollment"
      fi
      rm -f /tmp/pass.txt
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC SSH configurations"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC SSH configurations"
      mkdir -p /target/etc/ssh/sshd_config.d
      echo "# Disable reverse DNS lookups to prevent connection hangs in air-gapped segments" > /target/etc/ssh/sshd_config.d/gdc.conf
      echo "UseDNS no" >> /target/etc/ssh/sshd_config.d/gdc.conf
      logger -t gdc-provisioner "[GOAL] SSH UseDNS configuration created successfully"
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Deploying GDC Production VRF Netplan configuration"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Deploying GDC Production VRF Netplan configuration"
      
      # Invoke the safe structured Python network compiler
      mkdir -p /target/var/log
      if python3 /cdrom/custom-data/configure_netplan.py >/target/var/log/netplan-hydration.log 2>&1; then
        logger -t gdc-provisioner "[GOAL] GDC Production VRF Netplan compiled and validated successfully."
      else
        echo "[GDC-INSTALL-FAIL] Critical Failure: Programmatic Netplan compilation failed! Diagnostics written to /target/var/log/netplan-hydration.log" >/dev/ttyS0
        cat /target/var/log/netplan-hydration.log >/dev/ttyS0 || true
        exit 1
      fi
      
      # Redirect security upgrades to loopback to prevent long hangs during curtin installation
      echo "127.0.0.1 security.ubuntu.com" >> /target/etc/hosts
      echo "127.0.0.1 geoip.ubuntu.com" >> /target/etc/hosts
      echo "127.0.0.1 geoip.canonical.com" >> /target/etc/hosts
      
      # Dynamically configure unique hostname based on primary network interface MAC address
      PHYS_IFACE=$(ls /sys/class/net | grep -E '^e' | head -n 1 || echo "eth0")
      MAC_ADDR=$(cat /sys/class/net/${PHYS_IFACE}/address | tr -d ':')
      MAC_SUFFIX=$(echo -n "${MAC_ADDR}" | tail -c 4)
      NEW_HOSTNAME="gdc-standalone-node-${MAC_SUFFIX}"
      echo "${NEW_HOSTNAME}" > /target/etc/hostname
      
      # Ensure local hostname and GDC companion gateway mappings are present in /etc/hosts to prevent resolver hangs on boot
      echo "127.0.1.1 ${NEW_HOSTNAME}" >> /target/etc/hosts
      echo "192.168.120.2 gdc-companion.ensor-labs.com" >> /target/etc/hosts
      
      # Purge cloud-init and write the official disabled trigger file to prevent first-boot stalls
      logger -t gdc-provisioner "[GOAL] Disabling cloud-init on target OS"
      mkdir -p /target/etc/cloud
      touch /target/etc/cloud/cloud-init.disabled
      curtin in-target -- apt-get purge -y cloud-init || true
      rm -f /target/etc/issue.d/*cloud-init* || true
      rm -f /target/etc/issue.d/* || true
      
      # Disable unattended-upgrades on target OS to prevent first-boot package manager locks
      logger -t gdc-provisioner "[GOAL] Disabling unattended-upgrades on target OS"
      curtin in-target -- systemctl stop unattended-upgrades || true
      curtin in-target -- systemctl mask unattended-upgrades || true
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Configuring VRF sysctl profiles"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Configuring VRF sysctl profiles"
      mkdir -p /target/etc/sysctl.d
      echo "net.ipv4.tcp_l3mdev_accept=1" > /target/etc/sysctl.d/99-vrf.conf
      echo "net.ipv4.udp_l3mdev_accept=1" >> /target/etc/sysctl.d/99-vrf.conf
      logger -t gdc-provisioner "[GOAL] VRF sysctl profiles configured successfully"
    - |
      echo "=============================================================================="
      echo "[GDC-INSTALL-GOAL] Starting Task: Rebuilding initramfs ramdisks"
      echo "=============================================================================="
      logger -t gdc-provisioner "[GOAL] Rebuilding initramfs ramdisks"
      if curtin in-target -- update-initramfs -u -k all; then
        echo "=============================================================================="
        echo "[GDC-INSTALL-GOAL] All custom late commands succeeded!"
        echo "=============================================================================="
        logger -t gdc-provisioner "[GOAL] Rebuilding initramfs succeeded"
      else
        echo "[GDC-INSTALL-FAIL] Critical Failure: Rebuilding initramfs failed!"
        exit 1
      fi
