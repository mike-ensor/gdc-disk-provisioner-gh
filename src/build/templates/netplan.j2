network:
  version: 2
  renderer: networkd
  ethernets:
    # __MGMT_IFACE_START__
    __MGMT_IFACE__:
      dhcp4: true
      dhcp6: no
      link-local: []
    # __MGMT_IFACE_END__
    {{ phys_iface }}:
      dhcp4: true
      dhcp6: no
      link-local: []
  {% if k8s_vlan and k8s_vlan != '0' %}
  vlans:
    {{ phys_iface }}.{{ k8s_vlan }}:
      id: {{ k8s_vlan }}
      link: {{ phys_iface }}
      addresses: [__K8S_IP_CIDR__]
      routes:
        - to: default
          via: {{ k8s_gateway }}
          metric: 200
      nameservers:
        addresses: [{{ k8s_dns }}]
  {% endif %}
  vrfs:
    {% if k8s_vlan and k8s_vlan != '0' %}
    vrf-k8s:
      table: 20
      interfaces: [{{ phys_iface }}.{{ k8s_vlan }}]
    {% endif %}
