network:
  version: 2
  renderer: networkd
  ethernets:
    {{ phys_iface }}:
      dhcp4: no
      dhcp6: no
      link-local: []
      {% if not machine_vlan or machine_vlan == '0' %}
      addresses: [{{ machine_ip_cidr }}]
      routes:
        - to: default
          via: {{ machine_gateway }}
          metric: 100
      nameservers:
        addresses: [{{ machine_dns }}]
      {% endif %}
  {% if machine_vlan and machine_vlan != '0' or k8s_vlan and k8s_vlan != '0' %}
  vlans:
    {% if machine_vlan and machine_vlan != '0' %}
    {{ phys_iface }}.{{ machine_vlan }}:
      id: {{ machine_vlan }}
      link: {{ phys_iface }}
      addresses: [{{ machine_ip_cidr }}]
      routes:
        - to: default
          via: {{ machine_gateway }}
          metric: 100
      nameservers:
        addresses: [{{ machine_dns }}]
    {% endif %}
    {% if k8s_vlan and k8s_vlan != '0' %}
    {{ phys_iface }}.{{ k8s_vlan }}:
      id: {{ k8s_vlan }}
      link: {{ phys_iface }}
      addresses: [{{ k8s_ip_cidr }}]
      routes:
        - to: default
          via: {{ k8s_gateway }}
          metric: 200
      nameservers:
        addresses: [{{ k8s_dns }}]
    {% endif %}
  {% endif %}
  vrfs:
    vrf-machine:
      table: 10
      interfaces: [{{ vrf_machine_interfaces }}]
    {% if k8s_vlan and k8s_vlan != '0' %}
    vrf-k8s:
      table: 20
      interfaces: [{{ phys_iface }}.{{ k8s_vlan }}]
    {% endif %}