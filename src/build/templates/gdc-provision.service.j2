[Unit]
Description=GDC Ready-Linux First Boot Provisioner
After=network.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
Environment=ANSIBLE_FORCE_COLOR=1
EnvironmentFile=-/etc/default/gdc-provision
StandardOutput=file:/dev/ttyS0
StandardError=file:/dev/ttyS0
ExecStart=/bin/bash -c "git config --system --add safe.directory /var/lib/gitea/repos/gdc/bootstrap-playbooks.git || true; \
git config --system --add safe.directory '*' || true; \
/usr/bin/ansible-pull \
  -U /var/lib/gitea/repos/gdc/bootstrap-playbooks.git \
  -C {{ git_branch | default('main') }} \
  -i localhost, \
  $ANSIBLE_PULL_FLAGS \
  src/ansible/local.yml"
RemainAfterExit=true

[Install]
WantedBy=multi-user.target