# GDC Bootloader ISO Build Pipeline Environment Configuration

# ==========================================
# 1. Source ISO Settings
# ==========================================
# The "blessed" official Ubuntu 24.04 LTS Server ISO to start from
SOURCE_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04-live-server-amd64.iso
SOURCE_ISO_FILENAME=ubuntu-24.04-live-server-amd64.iso

# ==========================================
# 2. Versioning & Output Settings
# ==========================================
# Base semantic version of our custom GDC bootstrap ISO
ISO_VERSION=1.0.0
ISO_NAME_PREFIX=gdc-bootstrap-ubuntu-24.04

# ==========================================
# 3. Deployment Destinatons
# ==========================================
# Configure whether to publish compiled ISOs to local NFS, GCS, or both

# Google Cloud Storage (GCS) Publication Settings
ENABLE_GCS=false
GCS_BUCKET=gs://gdc-disk-provisioner-isos

# Local NFS Mount Publication Settings
ENABLE_NFS=false
NFS_DEPLOY_PATH=/mnt/nfs/isos
