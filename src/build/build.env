# ==============================================================================
# GDC Bare Metal ISO Build Pipeline Environment Configuration
# ==============================================================================
# This configuration file drives the automated remastering, dynamic LVM layout,
# isolated L3 networking configurations, and administrative credential injection
# for GDC Bare Metal node deployments on Ubuntu 24.04 LTS.
#
# DESIGN PATTERN:
# Public configuration defaults are maintained here. Personal keys, secrets, and
# production-grade overrides must be declared in the git-ignored 'local.env' file.
# ==============================================================================

# ==============================================================================
# GROUP 1: BASE OS & UPSTREAM SOURCE MEDIA
# ==============================================================================
# Consumed by remaster.sh to download, verify, and extract the upstream operating
# system image before dynamically injecting GDC automation layers.

# SOURCE_ISO_URL
# - How it is used: Specifies the official internet mirror to pull the base image.
# - Generation: Provide any HTTPS mirror link containing the verified upstream LTS release.
SOURCE_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.4-live-server-amd64.iso

# SOURCE_ISO_FILENAME
# - How it is used: Defines the local target cache filename to avoid repeated downloads.
# - Generation: Set to a clean, descriptive local filename.
SOURCE_ISO_FILENAME=ubuntu-24.04-live-server-amd64.iso

# _UBUNTU_VERSION
# - How it is used: Dictates the target OS version matching the blessed ISO,
#   controlling package resolution in cloudbuild-cache and docker compile bounds.
#   Used to configure local build contexts and force matching package cache retrieval.
# - Generation: Double-digit semantic string (e.g. '24.04' or '22.04').
_UBUNTU_VERSION=24.04

# BOOTSTRAP_BMCTL_VERSION
# - How it is used: Specifies the Google Distributed Cloud Bare Metal orchestrator and nodeagent version to cache into the ISO.
#   This is the *bootstrap* version; it may be overridden by gdc-companion settings during the ClusterReady stage.
# - Generation: Matches the desired upstream GKE Bare Metal release version.
BOOTSTRAP_BMCTL_VERSION="1.35.300-gke.87"

# ==============================================================================
# GROUP 2: PIPELINE VERSIONING & REPOSITORY INTEGRATION
# ==============================================================================
# Drives the output file naming conventions, dynamic system banners, and downstream
# Git repositories that boot-time agents pull local configurations from.

# ISO_VERSION
# - How it is used: Embedded in the dynamic Message of the Day (MOTD), system boot banners,
#   repackaged ISO output metadata, and Bootimus PXE registration tags.
# - Generation: Follow strict SemVer formats (e.g. 'MAJOR.MINOR.PATCH').
ISO_VERSION=0.4.1

# ISO_NAME_PREFIX
# - How it is used: Prefix string for compiling output filenames (e.g. 'gdc-bootstrap-ubuntu-24.04').
# - Generation: Standard alphanumeric string, lowercase with hyphens.
ISO_NAME_PREFIX=gdc-bootstrap-ubuntu-24.04

# UPSTREAM_PLAYBOOKS_REPO
# - How it is used: Clone source URL downloaded during node initialization to pull
#   Ansible Infrastructure-as-Code modules.
# - Generation: Provide any valid, accessible HTTPS git repository clone URL.
UPSTREAM_PLAYBOOKS_REPO=https://gitlab.com/gcp-solutions-public/retail-edge/gdc-disk-provisioner.git

# ANSIBLE_PLAYBOOK_HOME
# - How it is used: Specifies the destination sub-folder inside the Gitea bare repository
#   where playbooks are placed. Set to '/' to put playbooks directly at the root.
ANSIBLE_PLAYBOOK_HOME="/"

# GDC_RELEASE_USER_NAME
# - How it is used: Specifies the user.name configured for Gitea bootstrap repository commits.
GDC_RELEASE_USER_NAME="GDC Release Builder"

# GDC_RELEASE_USER_EMAIL
# - How it is used: Specifies the user.email configured for Gitea bootstrap repository commits.
GDC_RELEASE_USER_EMAIL="gdc-release@google.com"


# ==============================================================================
# GROUP 3: AUTOMATED PROVISIONING & INFRASTRUCTURE-AS-CODE
# ==============================================================================
# Governs the automation loops, local pull timers, and cryptographic signatures of
# post-install configurations executing directly on GDC bare-metal hosts.

# ANSIBLE_PULL_SCHEDULE
# - How it is used: Configures the calendar trigger interval inside the node's local
#   systemd-timer unit to synchronize, pull, and enforce the desired-state system layouts.
# - Generation: Must follow Systemd Timer OnCalendar spec (e.g. '02:00:00' for 2 AM daily,
#   'weekly', or 'Mon,Tue 12:00:00').
ANSIBLE_PULL_SCHEDULE="02:00:00"

# ENFORCE_SIGNED_COMMITS
# - How it is used: Passed to git config within the automated pull-agent. If set to 'true',
#   the node will reject pulling playbooks whose commits are not signed by authorized GPG keys.
# - Generation: Set to 'true' in high-security production environments, or 'false' for testing.
ENFORCE_SIGNED_COMMITS=false

# GDC_DEBUG_MODE
# - How it is used: Controls whether the compiled ISO is treated as a debug image.
#   If set to 'true', enables root SSH entries, skips signature verifications on logs,
#   and includes additional diagnostics files.
# - Generation: Set to 'true' or 'false'.
GDC_DEBUG_MODE=true


# ==============================================================================
# GROUP 4: TARGET OS IDENTITY & SECURITY CREDENTIALS
# ==============================================================================
# Secures GDC bare metal nodes immediately upon system extraction. Injects custom
# hardware-backed identity constraints, administrator public keys, and user passes.

# ADMIN_SSH_PUB_KEYS
# - How it is used: Injected directly into gdc-admin's
#   authorized_keys files during late-commands to grant passwordless SSH terminal entry.
# - Generation: Space-separated list of public key strings (e.g. 'ssh-ed25519 AAAAC3...').
#   RECOMMENDED: Leave empty here to prevent commits to Git, and set in 'local.env'.
ADMIN_SSH_PUB_KEYS=""

# TEMPORARY_INSTALLER_SSH_PUB_KEYS
# - How it is used: Injected directly into temporary-installer's
#   authorized_keys files during late-commands to grant passwordless SSH terminal entry.
# - Generation: Space-separated list of public key strings (e.g. 'ssh-ed25519 AAAAC3...').
#   RECOMMENDED: Leave empty here to prevent commits to Git, and set in 'local.env'.
TEMPORARY_INSTALLER_SSH_PUB_KEYS=""

# TEMPORARY_INSTALLER_PASSWORD
# - How it is used: Plaintext password set for the administrative OS user 'temporary-installer'.
#   At build time, remaster.sh dynamically generates a secure, randomized SHA-512 crypt hash
#   from this plaintext and injects only the hash, preventing plain-text exposure in configuration.
# - Generation: Custom entropy-rich password string.
#   RECOMMENDED: Keep default placeholder here and override with your secure password in 'local.env'.
TEMPORARY_INSTALLER_PASSWORD="default-password-123"


# ==============================================================================
# GROUP 5: SEGMENTED L3 NETWORKING & VRF ROUTING
# ==============================================================================
# Provisions robust, isolated network partitions to separate core GDC hardware management
# (Machine traffic) from cluster orchestration (Kubernetes traffic). Consumed by Netplan
# to configure multiple isolated L3 routing tables (Table 10 and Table 20).

BOOTSTRAP_HOST_NAME="gdc-default"

# VLAN Segregation IDs
# - How it is used: Configures tagged 802.1Q interfaces on the physical host interface.
# - Generation: Use 1-4094 representing network tags. Use '0' to disable tagging (flat network).
BOOTSTRAP_MACHINE_VLAN_ID=0
BOOTSTRAP_K8S_VLAN_ID=0

# Core Machine Network Parameters (Table 10)
# - How it is used: Controls static L3 assignment on the physical management network segment.
# - Generation: Provide an IP and subnet CIDR, Gateway IP, and DNS server IPs within segment.
# - Bootstrap Usage: These settings ONLY govern the LiveCD installer's initial network
#   environment to allow it to reach out to the GDC Companion over the management network.
BOOTSTRAP_MACHINE_DHCP4=true
BOOTSTRAP_MACHINE_DHCP6=false
BOOTSTRAP_MACHINE_IP_CIDR=192.168.4.11/24
BOOTSTRAP_MACHINE_GATEWAY=192.168.4.1
BOOTSTRAP_MACHINE_DNS="192.168.4.1, 8.8.8.8, 8.8.4.4"

# Isolated Kubernetes Cluster Parameters (Table 20)
# - How it is used: Controls static L3 assignment on the Kubernetes API/control-plane segment.
# - Generation: Provide an IP and subnet CIDR, Gateway IP, and DNS server IPs within segment.
# - Bootstrap Usage: These settings ONLY govern the LiveCD installer's initial network
#   environment to allow it to reach out to the GDC Companion over the cluster network.
BOOTSTRAP_K8S_IP_CIDR=192.168.4.10/29
BOOTSTRAP_K8S_GATEWAY=192.168.4.9
BOOTSTRAP_K8S_DNS="192.168.4.1, 8.8.8.8, 8.8.4.4"


# ==============================================================================
# GROUP 6: GDC COMPANION FALLBACK CONFIGURATION
# ==============================================================================
# Defines the offline fallback state if the GDC Companion API is unreachable.
# This prevents Ansible failures and allows the node to reach a standalone state.
# ==============================================================================
FALLBACK_MACHINE_STATE_STOP_STAGE=""
FALLBACK_CLUSTER_VLAN_ID="0"
FALLBACK_PEERS_JSON='[]'
FALLBACK_GCP_PROJECT_ID="gdc-example-project"
FALLBACK_GCP_REGION="us-central1"
FALLBACK_GCP_PRIMARY_GSA="gsa-example@gdc-example-project.iam.gserviceaccount.com"

# ==============================================================================
# GROUP 7: AUTOMATED INSTALLATION COMPANION WEBHOOKS
# ==============================================================================
# Drives live telemetry reporting from the boot loader straight back to the engineer.

# INSTALL_COMPANION_URL
# - How it is used: Registered in the Subiquity autoinstall user-data. The node streams
#   unattended install progress, console stdout, and failure reports live to this webhook.
#   Default public domain: gdc-companion.local on port 80.
# - Generation: Fully-qualified HTTP/HTTPS URL pointing to the secure GDC Companion DNS route.
INSTALL_COMPANION_URL=http://gdc-companion.example.com/v1/install-logs

# INSTALL_COMPANION_BASE
# - How it is used: Used as the base to request information from the GDC Companion
#   Default public domain: gdc-companion.local on port 443.
# - Generation: Fully-qualified HTTP/HTTPS URL pointing to the secure GDC Companion DNS route.
INSTALL_COMPANION_BASE=https://gdc-companion.example.com/

# INSTALL_COMPANION_API_KEY
# - How it is used: Used as an authentication mechanism to interact with GDC Companion implementation.
#   The value is sent with Authentication header: ie: Authentication Bearer [key]
# - Generation: Fully-qualified HTTP/HTTPS URL pointing to the secure GDC Companion DNS route.
INSTALL_COMPANION_API_KEY="not-filled-in-generate-new-within-companion-app="

# STEP_CA_URL
# - How it is used: Defines the endpoint for the Step CA server during node attestation.
# - Generation: Fully-qualified HTTP/HTTPS URL pointing to your Step CA instance.
STEP_CA_URL="https://step-ca.example.com"

# STEP_PROVISIONER_NAME
# - How it is used: Defines the provisioner name on the Step CA server used for TPM node attestation.
# - Generation: Name of the provisioner (e.g. 'tpm', 'admin').
STEP_PROVISIONER_NAME="tpm"

# STEP_PROVISIONER_PASSWORD
# - How it is used: Defines the password for JWK provisioners to generate one-time tokens.
# - Generation: Required if using a JWK provisioner.
STEP_PROVISIONER_PASSWORD=""

# PERSIST_ADD_HOSTS
# - How it is used: When set to 'true', injects the custom 'add-hosts' mappings into both
#   the live CD installer (/etc/hosts) and the persistent target machine OS (/target/etc/hosts).
# - Generation: Set to 'true' or 'false'.
PERSIST_ADD_HOSTS=false


# ==============================================================================
# GROUP 8: MULTI-CLOUD DEPLOYMENT & ARTIFACT REPUBLISHING
# ==============================================================================
# Directs build-pipeline upload runners to automatically sync finalized GDC bare-metal
# ISOs to private cloud storage buckets or corporate local mounts.

# Google Cloud Platform (GCP) Telemetry Destinations
# - How it is used: Sets target workspace descriptors for monitoring integration metrics.
# - Generation: Alphanumeric project ID from Google Cloud Console and regional zones.
PROJECT_ID=my-gcp-project-id
REGION=us-central1

# Google Cloud Storage (GCS) Publication
# - How it is used: When enabled, uploads the remastered ISO directly to GCS.
# - Generation: Set ENABLE_GCS to 'true' or 'false', and GCS_BUCKET to your destination URI.
ENABLE_GCS=true
GCS_BUCKET=gs://gdc-disk-provisioner-isos

# Corporate local NFS Mount Publication
# - How it is used: When enabled, copies the remastered ISO to local corporate NFS storage.
# - Generation: Set ENABLE_NFS to 'true' or 'false', and NFS_DEPLOY_PATH to your local mount path.
ENABLE_NFS=false
NFS_DEPLOY_PATH=/mnt/nfs/isos


# ==============================================================================
# GROUP 9: SYSTEM TESTING & VERIFICATION COMPATIBILITY
# ==============================================================================
# Used during the automated validation, verification, and local test phases of
# the GDC bare metal ISO development lifecycle.

# MACHINE_STATE_STOP_STAGE
# - How it is used: Injected into Ansible to halt the installation pipeline gracefully after the specified stage.
# - Generation: String matching a valid stage ID. Valid values: 'SECOND_BOOT', 'LINUX_READY', 'CLUSTER_READY'.
#   NOTE: 'LIVECD' and 'FIRST_BOOT' are NOT valid as they require automated unsealing reboots to complete safely.
MACHINE_STATE_STOP_STAGE=""

# POST_INSTALL_PACKAGES
# - How it is used: Defines the baseline system packages with strict versions to install
#   during Subiquity's automated user-data extraction.
# - Generation: Space-separated string list of packages with strict APT version bounds.
POST_INSTALL_PACKAGES="git net-tools arp-scan efibootmgr"

# TEST_PULL_OCI_IMAGE
# - How it is used: Integration image test variable verifying proxy nexus cache retrieval.
# - Generation: Fully-qualified registry image path name.
TEST_PULL_OCI_IMAGE=gcr.io/anthos-bare-metal-lab-1/vllm-shim:latest


# ==============================================================================
# GROUP 10: OFFLINE SERVICES BINARY ACQUISITION (STAGE 1)
# ==============================================================================
# All standard GGD Local Service Hub binary acquisition configurations, signatures,
# and file locations are maintained in the central dependency manifest file:
# 👉 src/dependencies.env
# ==============================================================================


# ==============================================================================
# GROUP 11: BOOTIMUS SYNC & SCAN POLLING TIMEOUTS
# ==============================================================================
# Controls the retry budget and intervals for locating newly compiled ISOs on
# the remote Bootimus PXE server after synchronization from GCS via Synology NAS.
#
# MATHEMATICAL JUSTIFICATION FOR DEFAULT LIMITS:
# - GCS-to-Synology NAS detection delay: ~30 seconds (polling interval).
# - ISO payload size: ~3.7 GB (3.7 * 1024 * 1024 * 1024 * 8 = ~31.8 billion bits).
# - Synology transfer speed: ~400 Mbps.
# - Net transmission time: ~31.8 Gb / 400 Mbps = ~80 seconds.
# - Minimum sync delay baseline: 30s (polling) + 80s (transfer) = 110 seconds.
# - Safety Factor / Variance Multiplier: ~3.2x buffer to absorb internet latency,
#   disk write contention, and scanner scheduling variance.
# - Target timeout limit: 360 seconds (6 minutes) total polling budget.
#
BOOTIMUS_SCAN_RETRIES=24
BOOTIMUS_SCAN_INTERVAL_SECONDS=15

# ==============================================================================
# GROUP 12: DEVELOPMENT & MOCKING CONFIGURATIONS
# ==============================================================================
# Enables bypassing external dependencies for local ISO compilation testing.

# MOCK_GDC_COMPANION_DATA
# - How it is used: If set, the remaster.sh script will look for a JSON file in the
#   project root at 'custom-data/machine-info-mock-[VALUE].json' and inject it into
#   the ISO as '/etc/gdc/machine-info-mock.json'. This automatically triggers the
#   Ansible playbooks to bypass the StepCA mTLS and GDC Companion API fetch processes,
#   relying purely on the seeded JSON file.
# - Generation: String suffix matching your mock file (e.g. 'net-109'). Leave empty
#   to build a production ISO.
MOCK_GDC_COMPANION_DATA=""
