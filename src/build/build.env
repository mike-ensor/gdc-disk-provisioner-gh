# GDC Bootloader ISO Build Pipeline Environment Configuration

# ==========================================
# 1. Source ISO Settings
# ==========================================
# The "blessed" official Ubuntu 24.04 LTS Server ISO to start from
SOURCE_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.4-live-server-amd64.iso
SOURCE_ISO_FILENAME=ubuntu-24.04-live-server-amd64.iso

# ==========================================
# 2. Versioning & Output Settings
# ==========================================
# Base semantic version of our custom GDC bootstrap ISO
ISO_VERSION=1.0.0
ISO_NAME_PREFIX=gdc-bootstrap-ubuntu-24.04

# Upstream Git repository containing GDC Bootstrap Ansible Playbooks
# This is cloned dynamically during the ISO build phase.
UPSTREAM_PLAYBOOKS_REPO=https://github.com/google/gdc-disk-provisioner.git

# Toggle to enforce GPG signed commits inside the local ansible-pull runner
# Set to 'false' during development/testing; set to 'true' for production enforcement.
ENFORCE_SIGNED_COMMITS=false

# Specific package list (and explicit versions) to install during post-install
# Format is a space-separated list of "package=version"
POST_INSTALL_PACKAGES="git=1:2.43.0-1ubuntu7 python3-pip=24.0+dfsg-1ubuntu1 wireguard=1.0.20210914-1ubuntu1"

# OCI Image to pull during Nexus proxy caching integration tests
TEST_PULL_OCI_IMAGE=gcr.io/anthos-bare-metal-lab-1/vllm-shim:latest

# ==========================================
# 3. Google Cloud Platform (GCP) Settings
# ==========================================
# Target GCP Project and Region for Log Monitoring and API endpoints
PROJECT_ID=my-gcp-project-id
REGION=us-central1

# ==========================================
# 4. Deployment Destinatons
# ==========================================
# Configure whether to publish compiled ISOs to local NFS, GCS, or both

# Google Cloud Storage (GCS) Publication Settings
ENABLE_GCS=false
GCS_BUCKET=gs://gdc-disk-provisioner-isos

# Local NFS Mount Publication Settings
ENABLE_NFS=false
NFS_DEPLOY_PATH=/mnt/nfs/isos

# ==========================================
# 5. Network Segment & VRF Configurations
# ==========================================
# VLAN IDs for network segregation (Machine vs Kubernetes traffic)
MACHINE_VLAN_ID=10
K8S_VLAN_ID=20

# Machine Interface IP address block, gateway and nameservers (Table 10)
MACHINE_IP_CIDR=192.168.10.5/24
MACHINE_GATEWAY=192.168.10.1
MACHINE_DNS_1=8.8.8.8
MACHINE_DNS_2=8.8.4.4

# Kubernetes Interface IP address block, gateway and nameservers (Table 20)
K8S_IP_CIDR=192.168.20.5/24
K8S_GATEWAY=192.168.20.1
K8S_DNS=1.1.1.1

# ==========================================
# 6. Installation Companion Webhook Settings
# ==========================================
# Webhook URL where the installer streams live logs and failure signals
# Points to the local corporate DNS domain pointing to our companion receiver
INSTALL_COMPANION_URL=http://gdc-companion.ensor-labs.com:8080/v1/install-logs
