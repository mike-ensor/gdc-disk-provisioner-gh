# ==============================================================================
# GDC Bare Metal ISO Build Pipeline - Local Environment Overrides
# ==============================================================================
# This file is git-ignored and intended only for official/local deltas from
# src/build/build.env. Keep this file limited to sensitive values and explicit
# build-specific overrides.

# ==============================================================================
# GROUP 1: BASE OS & UPSTREAM SOURCE MEDIA (VERSION OVERRIDES)
# ==============================================================================
# Keep only when intentionally pinning a build line (e.g. 24.04 vs 22.04).
_UBUNTU_VERSION=24.04


# ==============================================================================
# GROUP 4: TARGET OS IDENTITY & SECURITY CREDENTIALS
# ==============================================================================
TEMPORARY_INSTALLER_SSH_PUB_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII5qAYdMqylY+PYFPdBsp6e9zuVkJnd5eCsRKpYkO+B5 gdc-disk-provisioner"
ADMIN_SSH_PUB_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII5qAYdMqylY+PYFPdBsp6e9zuVkJnd5eCsRKpYkO+B5 gdc-disk-provisioner"
TEMPORARY_INSTALLER_PASSWORD="troubled-marble-150"


# ==============================================================================
# GROUP 5: SEGMENTED L3 NETWORKING & VRF ROUTING
# ==============================================================================
BOOTSTRAP_MACHINE_DHCP4=true
BOOTSTRAP_MACHINE_DHCP6=false
BOOTSTRAP_MACHINE_IP_CIDR=192.168.9.11/24
BOOTSTRAP_MACHINE_GATEWAY=192.168.9.1
BOOTSTRAP_MACHINE_DNS="192.168.254.13, 192.168.9.1, 8.8.8.8, 8.8.4.4"

# Isolated Kubernetes Cluster Parameters (Table 20)
# - How it is used: Controls static L3 assignment on the Kubernetes API/control-plane segment.
# - Generation: Provide an IP and subnet CIDR, Gateway IP, and DNS server IPs within segment.
# - Bootstrap Usage: These settings ONLY govern the LiveCD installer's initial network
#   environment to allow it to reach out to the GDC Companion over the cluster network.
BOOTSTRAP_K8S_IP_CIDR=192.168.9.10/29
BOOTSTRAP_K8S_GATEWAY=192.168.9.9
BOOTSTRAP_K8S_DNS="192.168.9.1, 8.8.8.8, 8.8.4.4"


# ==============================================================================
# GROUP 6: GDC COMPANION FALLBACK CONFIGURATION
# ==============================================================================
# Defines the offline fallback state if the GDC Companion API is unreachable.
# This prevents Ansible failures and allows the node to reach a standalone state.
# ==============================================================================
BOOTSTRAP_HOST_NAME="gdc-machine"
FALLBACK_CLUSTER_VLAN_ID="0"
FALLBACK_PEERS_JSON='[]'
FALLBACK_GCP_REGION="us-west1"
FALLBACK_GCP_PRIMARY_GSA="provisioning-gsa@anthos-bare-metal-lab-1.iam.gserviceaccount.com"

# ==============================================================================
# GROUP 7: AUTOMATED INSTALLATION COMPANION WEBHOOKS
# ==============================================================================
INSTALL_COMPANION_URL=https://gdc-companion.ensor-labs.com/v1/install-logs
INSTALL_COMPANION_BASE=https://gdc-companion.ensor-labs.com/
INSTALL_COMPANION_API_KEY="AOgIcFproZQpYgaqDJrsUOD1MfhxwFqBANp2JumB5wM="
STEP_CA_URL="https://step-ca.ensor-labs.com"
STEP_PROVISIONER_NAME="admin"
STEP_PROVISIONER_PASSWORD="JvXiHJWZNKR2qqX2yXywmjvuDIvBMgig"
PERSIST_ADD_HOSTS=true

# ==============================================================================
# GROUP 8: MULTI-CLOUD DEPLOYMENT & ARTIFACT REPUBLISHING
# ==============================================================================
PROJECT_ID=anthos-bare-metal-lab-1
REGION=us-west1


# ==============================================================================
# GROUP 9: SYSTEM TESTING & VERIFICATION COMPATIBILITY
# ==============================================================================
GDC_DEBUG_MODE=true
MACHINE_STATE_STOP_STAGE="CLUSTER_READY"


# ==============================================================================
# GROUP 12: DEVELOPMENT & MOCKING CONFIGURATIONS
# IF set, then use the `custom-data/machine-info-mock-[value].json` file, if empty,
# then do not use mocking data system
# ==============================================================================
MOCK_GDC_COMPANION_DATA=""
