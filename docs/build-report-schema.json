{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "UPSTREAM OWNER: gdc-companion (docs/build-report-schema.json). DO NOT EDIT DIRECTLY. This file is vendored from the gdc-companion repository to support hermetic, air-gapped CI and offline validation. Run bin/sync-schemas.sh to sync with upstream.",
  "title": "GDC ISO Build Report Schema",
  "description": "JSON schema for GDC custom bootloader ISO build outcomes and audit receipts.",
  "type": "object",
  "required": [
    "timestamp",
    "build_id",
    "iso_version",
    "status",
    "stages",
    "metadata",
    "binaries_audit",
    "packages_seeding",
    "deployment_verification"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp indicating when the report was compiled."
    },
    "build_id": {
      "type": "string",
      "description": "Unique identifier of the build."
    },
    "iso_version": {
      "type": "string",
      "description": "Version of the GDC custom ISO compiled."
    },
    "iso_profile": {
      "type": "string",
      "description": "Name or path of the environment profile used for ISO compilation (e.g., honeywell.env, custom-profile)."
    },
    "iso_environment": {
      "type": "string",
      "description": "Deprecated: Use iso_profile instead.",
      "deprecated": true
    },
    "iso_name": {
      "type": "string",
      "description": "Full target ISO output filename."
    },
    "environment_config": {
      "type": "object",
      "description": "Masked environment profile configurations from [ISO_ENVIRONMENT].env.",
      "required": [
        "environment",
        "variables"
      ],
      "properties": {
        "environment": {
          "type": "string"
        },
        "config_file": {
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED"
      ],
      "description": "Final compilation and validation result."
    },
    "metadata": {
      "type": "object",
      "required": [
        "git_branch",
        "git_commit",
        "host_os",
        "duration_seconds",
        "kvm_available",
        "local_iso_size_bytes",
        "local_iso_sha256"
      ],
      "properties": {
        "git_branch": {
          "type": "string"
        },
        "git_commit": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer"
        },
        "kvm_available": {
          "type": "boolean"
        },
        "local_iso_size_bytes": {
          "type": "integer"
        },
        "local_iso_sha256": {
          "type": "string"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "name",
          "status",
          "duration_seconds",
          "tests"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "SKIPPED",
              "WARNING"
            ]
          },
          "duration_seconds": {
            "type": "integer"
          },
          "error_logs": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "PASSED",
                    "FAILED",
                    "SKIPPED"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "binaries_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "filename",
          "expected_sha",
          "actual_sha",
          "verified",
          "source",
          "size_mb"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Semantic or release version of the binary."
          },
          "expected_sha": {
            "type": "string"
          },
          "actual_sha": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "size_mb": {
            "type": "number"
          },
          "last_updated": {
            "type": "string",
            "description": "RFC 3339 UTC timestamp indicating when the binary was last modified or created in its origin (GCS bucket or upstream mirror)."
          }
        }
      }
    },
    "packages_seeding": {
      "type": "object",
      "required": [
        "total_requested",
        "total_cached",
        "failures",
        "packages"
      ],
      "properties": {
        "total_requested": {
          "type": "integer"
        },
        "total_cached": {
          "type": "integer"
        },
        "cache_last_updated": {
          "type": "string",
          "description": "RFC 3339 UTC timestamp indicating when the package cache was last resolved and updated."
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "filename",
              "expected_sha",
              "actual_sha",
              "verified",
              "size_kb"
            ],
            "properties": {
              "filename": {
                "type": "string"
              },
              "expected_sha": {
                "type": "string"
              },
              "actual_sha": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "size_kb": {
                "type": "number"
              },
              "last_updated": {
                "type": "string",
                "description": "Timestamp or release date of the debian package."
              },
              "cvss_score": {
                "type": "number",
                "description": "Highest CVSS vulnerability score identified for this package version via OSV API (0.0 if clean)."
              }
            }
          }
        }
      }
    },
    "deployment_verification": {
      "type": "object",
      "required": [
        "deployed_to_gcs",
        "verified_on_gcs",
        "gcs_path"
      ],
      "properties": {
        "deployed_to_gcs": {
          "type": "boolean"
        },
        "verified_on_gcs": {
          "type": "boolean"
        },
        "gcs_path": {
          "type": "string"
        },
        "sha256_matches": {
          "type": "boolean"
        }
      }
    }
  }
}
