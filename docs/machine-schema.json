{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "UPSTREAM OWNER: gdc-companion (docs/machine-schema.json). DO NOT EDIT DIRECTLY. This file is vendored from the gdc-companion repository to support hermetic, air-gapped CI and offline validation. Run bin/sync-schemas.sh to sync with upstream.",
  "title": "GDC Bare-Metal Machine Config Schema",
  "description": "JSON schema for machine configuration objects served and ingested via /v1/machine-info/{mac-address}.",
  "type": "object",
  "required": [
    "hostname",
    "bmctl_version",
    "network",
    "gcp_info",
    "cluster",
    "peers"
  ],
  "properties": {
    "hostname": {
      "type": "string",
      "description": "Target machine hostname."
    },
    "bmctl_version": {
      "type": "string",
      "description": "Version of bmctl / Anthos bare metal orchestration tool."
    },
    "network": {
      "type": "object",
      "description": "Network configurations for management and cluster interfaces.",
      "required": [
        "management_network",
        "cluster_network"
      ],
      "properties": {
        "management_network": {
          "type": "object",
          "description": "Management interface network settings.",
          "required": [
            "dhcp_v4",
            "dns_servers"
          ],
          "properties": {
            "dhcp_v4": {
              "type": "boolean",
              "description": "Whether IPv4 DHCP is enabled. If true, ip_cidr is optional."
            },
            "ip_cidr": {
              "type": "string",
              "description": "Static IPv4 address and CIDR prefix (e.g. 192.168.9.150/24)."
            },
            "gateway": {
              "type": "string",
              "description": "Default gateway IPv4 address."
            },
            "dns_servers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of DNS server IPv4 addresses."
            }
          }
        },
        "cluster_network": {
          "type": "object",
          "description": "Cluster VLAN interface network settings.",
          "required": [
            "vlan_id",
            "dhcp_v4"
          ],
          "properties": {
            "vlan_id": {
              "type": "integer",
              "description": "802.1Q VLAN ID for cluster network."
            },
            "dhcp_v4": {
              "type": "boolean",
              "description": "Whether IPv4 DHCP is enabled on cluster interface."
            },
            "ip_cidr": {
              "type": "string",
              "description": "Static IPv4 address and CIDR prefix on cluster interface (e.g. 192.168.109.12/24)."
            },
            "gateway": {
              "type": "string",
              "description": "Optional gateway IPv4 address on cluster network (falls back to management gateway if omitted)."
            },
            "dns_servers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional array of DNS server IPv4 addresses on cluster network."
            }
          }
        }
      }
    },
    "gcp_info": {
      "type": "object",
      "description": "Google Cloud Platform metadata and service account configuration.",
      "required": [
        "project_id",
        "region",
        "primary_gsa"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "description": "GCP Project ID."
        },
        "region": {
          "type": "string",
          "description": "GCP Region name."
        },
        "primary_gsa": {
          "type": "string",
          "description": "Primary Google Service Account email address."
        }
      }
    },
    "cluster": {
      "type": "object",
      "description": "Target cluster configuration metadata.",
      "required": [
        "cluster_name",
        "networking",
        "fleet_cluster_labels"
      ],
      "properties": {
        "cluster_name": {
          "type": "string"
        },
        "config_sync_enabled": {
          "type": "boolean",
          "description": "Optional toggle to install ConfigSync operator. Defaults to true.",
          "default": true
        },
        "primary_root_repo": {
          "description": "Primary RootSync repository configuration (git or oci).",
          "oneOf": [
            {
              "type": "string",
              "description": "Legacy OCI or Git URI string for backward compatibility."
            },
            {
              "type": "null",
              "description": "Null if ConfigSync is enabled without a root repo."
            },
            {
              "type": "object",
              "description": "Structured Git or OCI repository configuration.",
              "properties": {
                "cluster_config_name": {
                  "type": "string",
                  "description": "Optional override for cluster subfolder directory under config/clusters/."
                },
                "cluster-config-name": {
                  "type": "string",
                  "description": "Optional override for cluster subfolder directory under config/clusters/ (kebab-case)."
                },
                "git": {
                  "type": "object",
                  "description": "Git repository configuration for ConfigSync RootSync.",
                  "anyOf": [
                    {
                      "required": [
                        "repo_url"
                      ]
                    },
                    {
                      "required": [
                        "repo-url"
                      ]
                    }
                  ],
                  "properties": {
                    "repo_url": {
                      "type": "string",
                      "description": "Git repository URL."
                    },
                    "repo-url": {
                      "type": "string",
                      "description": "Git repository URL (kebab-case)."
                    },
                    "branch": {
                      "type": "string",
                      "default": "main",
                      "description": "Git branch to sync."
                    },
                    "cluster_config_name": {
                      "type": "string",
                      "description": "Optional override for cluster subfolder directory under config/clusters/."
                    },
                    "cluster-config-name": {
                      "type": "string",
                      "description": "Optional override for cluster subfolder directory under config/clusters/ (kebab-case)."
                    },
                    "gsm_secret_name": {
                      "type": "string",
                      "description": "Secret Manager secret name containing read-only Git PAT / credentials."
                    },
                    "gsm_location": {
                      "type": "string",
                      "default": "global",
                      "description": "Secret Manager secret location/replication (e.g. global, us-west1)."
                    },
                    "gsm-location": {
                      "type": "string",
                      "default": "global",
                      "description": "Secret Manager secret location/replication (kebab-case alias)."
                    },
                    "gsm-auth-secret": {
                      "type": "object",
                      "description": "Structured secret mapping Google Secret Manager to Kubernetes.",
                      "anyOf": [
                        {
                          "required": [
                            "gsm-name"
                          ]
                        },
                        {
                          "required": [
                            "gsm_name"
                          ]
                        }
                      ],
                      "properties": {
                        "gsm-name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP."
                        },
                        "gsm_name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP (snake_case alias)."
                        },
                        "gsm-location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (e.g. global, us-west1)."
                        },
                        "gsm_location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (snake_case alias)."
                        },
                        "k8s-name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync."
                        },
                        "k8s_name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync (snake_case alias)."
                        },
                        "k8s-namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace."
                        },
                        "k8s_namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace (snake_case alias)."
                        }
                      }
                    },
                    "gsm_auth_secret": {
                      "type": "object",
                      "description": "Structured secret mapping Google Secret Manager to Kubernetes (snake_case alias).",
                      "anyOf": [
                        {
                          "required": [
                            "gsm-name"
                          ]
                        },
                        {
                          "required": [
                            "gsm_name"
                          ]
                        }
                      ],
                      "properties": {
                        "gsm-name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP."
                        },
                        "gsm_name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP (snake_case alias)."
                        },
                        "gsm-location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (e.g. global, us-west1)."
                        },
                        "gsm_location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (snake_case alias)."
                        },
                        "k8s-name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync."
                        },
                        "k8s_name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync (snake_case alias)."
                        },
                        "k8s-namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace."
                        },
                        "k8s_namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace (snake_case alias)."
                        }
                      }
                    }
                  }
                },
                "oci": {
                  "type": "object",
                  "description": "OCI registry configuration for ConfigSync RootSync.",
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "description": "OCI image reference."
                    },
                    "dir-path": {
                      "type": "string",
                      "description": "Optional directory path to sync from inside the container filesystem."
                    },
                    "gsa": {
                      "type": "string",
                      "description": "GCP Service Account name for Workload Identity Artifact Registry access."
                    },
                    "gsm_secret_name": {
                      "type": "string",
                      "description": "Secret Manager secret name containing read-only registry pull credentials."
                    },
                    "gsm_location": {
                      "type": "string",
                      "default": "global",
                      "description": "Secret Manager secret location/replication (e.g. global, us-west1)."
                    },
                    "gsm-location": {
                      "type": "string",
                      "default": "global",
                      "description": "Secret Manager secret location/replication (kebab-case alias)."
                    },
                    "gsm-auth-secret": {
                      "type": "object",
                      "description": "Structured secret mapping Google Secret Manager to Kubernetes.",
                      "anyOf": [
                        {
                          "required": [
                            "gsm-name"
                          ]
                        },
                        {
                          "required": [
                            "gsm_name"
                          ]
                        }
                      ],
                      "properties": {
                        "gsm-name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP."
                        },
                        "gsm_name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP (snake_case alias)."
                        },
                        "gsm-location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (e.g. global, us-west1)."
                        },
                        "gsm_location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (snake_case alias)."
                        },
                        "k8s-name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync."
                        },
                        "k8s_name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync (snake_case alias)."
                        },
                        "k8s-namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace."
                        },
                        "k8s_namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace (snake_case alias)."
                        }
                      }
                    },
                    "gsm_auth_secret": {
                      "type": "object",
                      "description": "Structured secret mapping Google Secret Manager to Kubernetes (snake_case alias).",
                      "anyOf": [
                        {
                          "required": [
                            "gsm-name"
                          ]
                        },
                        {
                          "required": [
                            "gsm_name"
                          ]
                        }
                      ],
                      "properties": {
                        "gsm-name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP."
                        },
                        "gsm_name": {
                          "type": "string",
                          "description": "Secret Manager secret name containing credentials in GCP (snake_case alias)."
                        },
                        "gsm-location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (e.g. global, us-west1)."
                        },
                        "gsm_location": {
                          "type": "string",
                          "default": "global",
                          "description": "Secret Manager secret location/replication (snake_case alias)."
                        },
                        "k8s-name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync."
                        },
                        "k8s_name": {
                          "type": "string",
                          "description": "Kubernetes Secret name created in k8s-namespace and referenced by RootSync (snake_case alias)."
                        },
                        "k8s-namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace."
                        },
                        "k8s_namespace": {
                          "type": "string",
                          "default": "config-management-system",
                          "description": "Target Kubernetes namespace (snake_case alias)."
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "primary_root_repo_auth_secret": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional legacy authentication secret name for primary_root_repo string."
        },
        "networking": {
          "type": "object",
          "required": [
            "cluster_vip",
            "cluster_ingress",
            "cluster_lb_range"
          ],
          "properties": {
            "cluster_vip": {
              "type": "string"
            },
            "cluster_ingress": {
              "type": "string"
            },
            "cluster_lb_range": {
              "type": "string"
            }
          }
        },
        "fleet_cluster_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cluster_admin_emails": {
          "type": "array",
          "description": "Optional list of admin user email addresses granted RBAC cluster-admin permissions.",
          "items": {
            "type": "string"
          }
        },
        "sub_ca_secret": {
          "type": "object",
          "description": "Enterprise Intermediate Sub-CA credentials stored in Google Cloud Secret Manager",
          "required": [
            "gsm-name"
          ],
          "properties": {
            "gsm-name": {
              "type": "string",
              "description": "Identifier of the Secret Manager secret holding the Sub-CA JSON payload"
            },
            "gsm-location": {
              "type": "string",
              "default": "global",
              "description": "Secret Manager replication location (e.g., global, us-central1)"
            }
          }
        }
      }
    },
    "peers": {
      "type": "array",
      "description": "Array of peer node definitions.",
      "items": {
        "type": "object",
        "required": [
          "hostname",
          "ipv4"
        ],
        "properties": {
          "hostname": {
            "type": "string"
          },
          "ipv4": {
            "type": "string"
          },
          "node_type": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "custom_extensions": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional custom Ansible playbook lifecycle extension configuration.",
      "properties": {
        "bundle_url": {
          "type": "string",
          "format": "uri",
          "description": "HTTPS URL from which the edge node downloads the playbook tarball."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "Hex-encoded SHA-256 checksum of the bundle tarball."
        }
      },
      "required": [
        "bundle_url",
        "sha256"
      ]
    },
    "machine_state_stop_stage": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional lifecycle stage at which to gracefully halt provisioning (e.g. FIRST_BOOT, SECOND_BOOT, LINUX_READY, CLUSTER_READY, CLUSTER_TURNUP, POST_CLUSTER, UPKEEP)."
    }
  }
}
