# ==============================================================================
# GDC Bare Metal - Ansible Lint Configuration
# ==============================================================================
profile: min

exclude_paths:
  - .cache/
  - venv/
  - .venv/
  - build-workspace/
  - .review/
  - docs/
  - test/
  - src/build/
  - .gitlab-ci.yml
  - cloudbuild.yaml
  - cloudbuild-cache.yaml

warn_list:
  - line-length
  - yaml
  - no-changed-when
  - ignore-errors
  - risky-shell-pipe
  - command-instead-of-module
  - command-instead-of-shell
  - key-order
